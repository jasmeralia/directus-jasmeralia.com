---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../../../components/GameThumbCard.astro";
import { directusFetchItems, getReviewedGameIds, getSTierGameIds, getTierChipsByGameId } from "../../../../../lib/directus";
import { sectionDataState } from "../../../../../lib/game-bundles";
import { expandGenreSlugs, hasGenreMembership } from "../../../../../lib/genre-supersets";
import { csvDataUri, gamesToCsv } from "../../../../../lib/csv";
import { GAME_THUMB_FIELDS } from "../../../../../lib/game-fields";
import { sortByTitle } from "../../../../../lib/list-format";

export async function getStaticPaths() {
  const games = await directusFetchItems("games", {
    fields: GAME_THUMB_FIELDS,
    limit: -1,
  });

  const combinations = new Set();
  for (const game of games ?? []) {
    const state = sectionDataState(game);
    const genreSlugs =
      (game.genres ?? []).map((entry) => entry?.genres_id?.slug).filter(Boolean);
    const genres = genreSlugs.length ? expandGenreSlugs(genreSlugs) : ["unknown"];
    for (const genre of genres) combinations.add(`${state}::${genre}`);
  }

  return Array.from(combinations).map((key) => {
    const [state, genre] = key.split("::");
    return { params: { state, genre }, props: { games } };
  });
}

const { state, genre } = Astro.params;
const { games: allGames } = Astro.props;
const labelize = (value) =>
  value ? value.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()) : "";
const stateLabel = labelize(state);
const genres = await directusFetchItems("genres", {
  fields: ["slug", "name"],
  filter: { slug: { _eq: genre } },
  limit: 1,
});
const genreLabel = genre === "unknown" ? "Unknown" : (genres?.[0]?.name ?? genre);

let games = (allGames ?? []).filter((game) => sectionDataState(game) === state);
if (genre === "unknown") {
  games = games.filter((game) => (game.genres ?? []).length === 0);
} else {
  games = games.filter((game) =>
    hasGenreMembership(
      (game.genres ?? []).map((entry) => entry?.genres_id?.slug).filter(Boolean),
      genre,
    ),
  );
}
games = sortByTitle(games);

const gameIds = games.map((game) => game.id).filter((id) => typeof id === "number");
const [reviewedGameIds, sTierGameIds, tierChipsByGame] = await Promise.all([
  getReviewedGameIds(gameIds),
  getSTierGameIds(gameIds),
  getTierChipsByGameId(gameIds),
]);

const csvName = `section-data-${state}-genre-${genre}.csv`;
const csvHref = csvDataUri(gamesToCsv(games));
---

<BaseLayout title={`Filters | Section Data ${stateLabel} + Genre: ${genreLabel}`}>
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title={`Section Data: ${stateLabel} + Genre: ${genreLabel}`} count={games.length} csvHref={csvHref} csvName={csvName} />
      <p>
        Section data: <strong>{stateLabel}</strong> &nbsp;|&nbsp;
        Genre: <strong>{genreLabel}</strong>
      </p>
    </div>
    <ThumbnailBorderLegend />
    {games.length === 0 ? (
      <p>No games found for this combination.</p>
    ) : (
      <div class="grid">
        {games.map((game) => (
          <GameThumbCard
            game={game}
            reviewed={reviewedGameIds.has(game.id)}
            sTier={sTierGameIds.has(game.id)}
            tierChips={tierChipsByGame.get(game.id) ?? []}
          />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
