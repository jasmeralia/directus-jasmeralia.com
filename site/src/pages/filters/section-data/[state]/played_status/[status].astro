---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../../../components/GameThumbCard.astro";
import { directusFetchItems, getSTierGameIds } from "../../../../../lib/directus";
import { csvDataUri, gamesToCsv } from "../../../../../lib/csv";
import { GAME_THUMB_FIELDS } from "../../../../../lib/game-fields";
import { sortByTitle } from "../../../../../lib/list-format";

export async function getStaticPaths() {
  const games = await directusFetchItems("games", {
    fields: ["id", "player_status", "sections.id"],
    limit: -1,
  });

  const comboCounts = new Map();
  for (const game of games ?? []) {
    if (!game.player_status) continue;
    const state = (game.sections ?? []).length > 0 ? "present" : "missing";
    const key = `${state}::${game.player_status}`;
    comboCounts.set(key, (comboCounts.get(key) || 0) + 1);
  }

  return Array.from(comboCounts.keys()).map((key) => {
    const [state, status] = key.split("::");
    return { params: { state, status } };
  });
}

const { state, status } = Astro.params;
const labelize = (value) =>
  value ? value.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()) : "";
const stateLabel = state === "present" ? "Present" : "Missing";
const statusLabel = labelize(status);

const gamesForStatus = await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  filter: { player_status: { _eq: status } },
  limit: -1,
});

let games = gamesForStatus.filter((game) => {
  const hasSections = (game.sections ?? []).length > 0;
  return state === "present" ? hasSections : !hasSections;
});
games = sortByTitle(games);

const gameIds = games.map((game) => game.id).filter((id) => typeof id === "number");
const reviewedGameIds = new Set();
if (gameIds.length) {
  const reviews = await directusFetchItems("reviews", {
    fields: ["game.id"],
    filter: { status: { _eq: "published" }, game: { _in: gameIds } },
    limit: -1,
  });
  for (const review of reviews ?? []) {
    const id = review?.game?.id;
    if (typeof id === "number") reviewedGameIds.add(id);
  }
}
const sTierGameIds = await getSTierGameIds(gameIds);

const csvName = `section-data-${state}-played-status-${status}.csv`;
const csvHref = csvDataUri(gamesToCsv(games));
---

<BaseLayout title={`Filters | Section Data ${stateLabel} + ${statusLabel}`}>
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title={`Section Data: ${stateLabel} + ${statusLabel}`} count={games.length} csvHref={csvHref} csvName={csvName} />
      <p>
        Section data: <strong>{stateLabel}</strong> &nbsp;|&nbsp;
        Played status: <strong>{statusLabel}</strong>
      </p>
    </div>
    <ThumbnailBorderLegend />
    {games.length === 0 ? (
      <p>No games found for this combination.</p>
    ) : (
      <div class="grid">
        {games.map((game) => {
          const reviewed = reviewedGameIds.has(game.id);
          const sTier = sTierGameIds.has(game.id);
          return <GameThumbCard game={game} reviewed={reviewed} sTier={sTier} />;
        })}
      </div>
    )}
  </main>
</BaseLayout>
