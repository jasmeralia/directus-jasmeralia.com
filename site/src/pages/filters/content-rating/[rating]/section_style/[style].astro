---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../../../components/GameThumbCard.astro";
import { directusFetchItems, getReviewedGameIds, getSTierGameIds } from "../../../../../lib/directus";
import { csvDataUri, gamesToCsv } from "../../../../../lib/csv";
import { effectiveSectionStyle } from "../../../../../lib/game-bundles";
import { GAME_THUMB_FIELDS } from "../../../../../lib/game-fields";
import { sortByTitle } from "../../../../../lib/list-format";
import { CONTENT_RATING_META, contentRating, isContentRating } from "../../../../../lib/nsfw";

const STYLE_LABEL = { linear: "Linear", nonlinear: "Nonlinear" };

export async function getStaticPaths() {
  const games = await directusFetchItems("games", {
    fields: [
      "id",
      "nsfw",
      "genres.genres_id.nsfw",
      "section_style",
      "sections.id",
      "bundle_members.id",
      "bundle_members.section_data_status",
    ],
    limit: -1,
  });

  // Only emit combinations that actually have games, so the filters index
  // never links to an empty page. effectiveSectionStyle() is null until real
  // section data exists, so untracked games don't inflate either style.
  const comboKeys = new Set();
  for (const game of games ?? []) {
    const style = effectiveSectionStyle(game);
    if (!style) continue;
    comboKeys.add(`${contentRating(game)}::${style}`);
  }

  return Array.from(comboKeys).map((key) => {
    const [rating, style] = key.split("::");
    return { params: { rating, style } };
  });
}

const { rating, style } = Astro.params;
if (!isContentRating(rating)) {
  throw new Error(`Unsupported content rating filter: ${rating}`);
}
if (!style || !(style in STYLE_LABEL)) {
  throw new Error(`Unsupported section style filter: ${style}`);
}
const meta = CONTENT_RATING_META[rating];
const styleLabel = STYLE_LABEL[style as keyof typeof STYLE_LABEL];

const candidates = await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  filter: { section_style: { _eq: style } },
  limit: -1,
});
const games = sortByTitle(
  (candidates ?? []).filter(
    (game) => contentRating(game) === rating && effectiveSectionStyle(game) === style,
  ),
);

const gameIds = games.map((game) => game.id).filter((id) => typeof id === "number");
const [reviewedGameIds, sTierGameIds] = await Promise.all([
  getReviewedGameIds(gameIds),
  getSTierGameIds(gameIds),
]);

const csvName = `content-rating-${rating}-section-style-${style}.csv`;
const csvHref = csvDataUri(gamesToCsv(games));
---

<BaseLayout title={`Filters | Content Rating ${meta.label} + ${styleLabel}`}>
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title={`Content Rating: ${meta.label} + ${styleLabel}`} count={games.length} csvHref={csvHref} csvName={csvName} />
      <p>
        Content rating: <strong><a href={`/filters/content-rating/${rating}/index.html`}>{meta.label}</a></strong> &nbsp;|&nbsp;
        Section style: <strong><a href={`/filters/section-style/${style}/index.html`}>{styleLabel}</a></strong>
      </p>
      <p>{meta.description}</p>
    </div>
    <ThumbnailBorderLegend />
    {games.length === 0 ? (
      <p>No games found for this combination.</p>
    ) : (
      <div class="grid">
        {games.map((game) => (
          <GameThumbCard
            game={game}
            reviewed={reviewedGameIds.has(game.id)}
            sTier={sTierGameIds.has(game.id)}
          />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
