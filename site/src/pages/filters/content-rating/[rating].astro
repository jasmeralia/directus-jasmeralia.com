---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../components/GameThumbCard.astro";
import { directusFetchItems, getReviewedGameIds, getSTierGameIds } from "../../../lib/directus";
import { csvDataUri, gamesToCsv } from "../../../lib/csv";
import { effectiveSectionStyle } from "../../../lib/game-bundles";
import { GAME_THUMB_FIELDS } from "../../../lib/game-fields";
import { compareLabels, sortByTitle } from "../../../lib/list-format";
import {
  CONTENT_RATINGS,
  CONTENT_RATING_META,
  contentRating,
  isContentRating,
} from "../../../lib/nsfw";

export async function getStaticPaths() {
  return CONTENT_RATINGS.map((rating) => ({ params: { rating } }));
}

const { rating } = Astro.params;
if (!isContentRating(rating)) {
  throw new Error(`Unsupported content rating filter: ${rating}`);
}
const meta = CONTENT_RATING_META[rating];

const games = sortByTitle(await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  limit: -1,
}));
const filteredGames = games.filter((game) => contentRating(game) === rating);
const gameIds = filteredGames
  .map((game) => game.id)
  .filter((id) => typeof id === "number");
const [reviewedGameIds, sTierGameIds] = await Promise.all([
  getReviewedGameIds(gameIds),
  getSTierGameIds(gameIds),
]);
const csvName = `content-rating-${rating}.csv`;
const csvHref = csvDataUri(gamesToCsv(filteredGames));

const labelize = (value) =>
  value ? value.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()) : "";
const playedStatusCounts = new Map();
for (const game of filteredGames) {
  if (!game.player_status) continue;
  playedStatusCounts.set(
    game.player_status,
    (playedStatusCounts.get(game.player_status) || 0) + 1,
  );
}
const playedStatusEntries = Array.from(playedStatusCounts.entries())
  .map(([status, count]) => ({ status, count, statusLabel: labelize(status) }))
  .sort((a, b) => compareLabels(a.statusLabel, b.statusLabel));

const gameStatusCounts = new Map();
for (const game of filteredGames) {
  if (!game.game_status) continue;
  gameStatusCounts.set(
    game.game_status,
    (gameStatusCounts.get(game.game_status) || 0) + 1,
  );
}
const gameStatusEntries = Array.from(gameStatusCounts.entries())
  .map(([status, count]) => ({ status, count, statusLabel: labelize(status) }))
  .sort((a, b) => compareLabels(a.statusLabel, b.statusLabel));

const STYLE_LABEL = { linear: "Linear", nonlinear: "Nonlinear" };
const sectionStyleCounts = new Map();
for (const game of filteredGames) {
  const style = effectiveSectionStyle(game);
  if (!style) continue;
  sectionStyleCounts.set(style, (sectionStyleCounts.get(style) || 0) + 1);
}
const sectionStyleEntries = Array.from(sectionStyleCounts.entries())
  .map(([style, count]) => ({
    style,
    count,
    styleLabel: STYLE_LABEL[style as keyof typeof STYLE_LABEL] ?? style,
  }))
  .sort((a, b) => compareLabels(a.styleLabel, b.styleLabel));
---

<BaseLayout title={`Filters | Content Rating + ${meta.label}`}>
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
      .panel h2{margin:0 0 8px 0;font-size:1.05rem;}
      .combos{list-style:disc;margin:0;padding-left:20px;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title={`Content Rating + ${meta.label}`} count={filteredGames.length} csvHref={csvHref} csvName={csvName} />
      <p>{meta.description}</p>
    </div>
    {sectionStyleEntries.length > 0 ? (
      <div class="panel">
        <h2>Narrow by Section Style</h2>
        <ul class="combos">
          {sectionStyleEntries.map((entry) => (
            <li>
              <a href={`/filters/content-rating/${rating}/section_style/${entry.style}/index.html`}>{meta.label} + {entry.styleLabel}</a>
              <span style="opacity:.7;"> ({entry.count})</span>
            </li>
          ))}
        </ul>
      </div>
    ) : null}
    {gameStatusEntries.length > 0 ? (
      <div class="panel">
        <h2>Narrow by Game Status</h2>
        <ul class="combos">
          {gameStatusEntries.map((entry) => (
            <li>
              <a href={`/filters/content-rating/${rating}/game_status/${entry.status}/index.html`}>{meta.label} + {entry.statusLabel}</a>
              <span style="opacity:.7;"> ({entry.count})</span>
            </li>
          ))}
        </ul>
      </div>
    ) : null}
    {playedStatusEntries.length > 0 ? (
      <div class="panel">
        <h2>Narrow by Played Status</h2>
        <ul class="combos">
          {playedStatusEntries.map((entry) => (
            <li>
              <a href={`/filters/content-rating/${rating}/played_status/${entry.status}/index.html`}>{meta.label} + {entry.statusLabel}</a>
              <span style="opacity:.7;"> ({entry.count})</span>
            </li>
          ))}
        </ul>
      </div>
    ) : null}
    <ThumbnailBorderLegend />
    {filteredGames.length === 0 ? (
      <p>No {meta.label} games found.</p>
    ) : (
      <div class="grid">
        {filteredGames.map((game) => (
          <GameThumbCard
            game={game}
            reviewed={reviewedGameIds.has(game.id)}
            sTier={sTierGameIds.has(game.id)}
          />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
