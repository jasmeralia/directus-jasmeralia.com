---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../../../components/GameThumbCard.astro";
import { directusFieldChoiceMap } from "../../../../../lib/directus";
import { directusFetchItems, getReviewedGameIds, getSTierGameIds, getTierChipsByGameId } from "../../../../../lib/directus";
import { expandGenreSlugs, hasGenreMembership } from "../../../../../lib/genre-supersets";
import { csvDataUri, gamesToCsv } from "../../../../../lib/csv";
import { GAME_THUMB_FIELDS } from "../../../../../lib/game-fields";
import { sortByTitle } from "../../../../../lib/list-format";

export async function getStaticPaths() {
  const games = await directusFetchItems("games", {
    fields: ["id", "game_status", "genres.genres_id.slug"],
    limit: -1,
  });

  const comboCounts = new Map();
  const genreStatusValues = new Map();
  for (const game of games ?? []) {
    if (!game.game_status) continue;
    const genreSlugs =
      (game.genres ?? []).map((entry) => entry?.genres_id?.slug).filter(Boolean);
    const genresForGame = genreSlugs.length ? expandGenreSlugs(genreSlugs) : ["unknown"];
    for (const genre of genresForGame) {
      const key = `${genre}::${game.game_status}`;
      comboCounts.set(key, (comboCounts.get(key) || 0) + 1);
      if (!genreStatusValues.has(genre)) {
        genreStatusValues.set(genre, new Set());
      }
      genreStatusValues.get(genre).add(game.game_status);
    }
  }

  return Array.from(comboCounts.keys())
    .filter((key) => {
      const [genre] = key.split("::");
      return (genreStatusValues.get(genre)?.size ?? 0) > 1;
    })
    .map((key) => {
      const [genre, status] = key.split("::");
      return { params: { genre, status } };
    });
}

const { genre, status } = Astro.params;
const labelize = (value) =>
  value ? value.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()) : "";

const genres = await directusFetchItems("genres", {
  fields: ["slug", "name"],
  filter: { slug: { _eq: genre } },
  limit: 1,
});
const genreLabel = genre === "unknown" ? "Unknown" : (genres?.[0]?.name ?? genre);
const gameStatusLabels = await directusFieldChoiceMap("games", "game_status");
const statusLabel = gameStatusLabels.get(status) ?? labelize(status);

let games = await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  filter: { game_status: { _eq: status } },
  limit: -1,
});

if (genre === "unknown") {
  games = games.filter((game) => (game.genres ?? []).length === 0);
} else {
  games = games.filter((game) =>
    hasGenreMembership(
      (game.genres ?? []).map((entry) => entry?.genres_id?.slug).filter(Boolean),
      genre,
    ),
  );
}
games = sortByTitle(games);

const gameIds = games.map((game) => game.id).filter((id) => typeof id === "number");
const [reviewedGameIds, sTierGameIds, tierChipsByGame] = await Promise.all([
  getReviewedGameIds(gameIds),
  getSTierGameIds(gameIds),
  getTierChipsByGameId(gameIds),
]);

const csvName = `genre-${genre}-game-status-${status}.csv`;
const csvHref = csvDataUri(gamesToCsv(games));
---

<BaseLayout title={`Filters | ${genreLabel} + ${statusLabel}`}>
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title={`${genreLabel} + ${statusLabel}`} count={games.length} csvHref={csvHref} csvName={csvName} />
      <p>
        Genre: <strong>{genreLabel}</strong> &nbsp;|&nbsp;
        Game status: <strong>{statusLabel}</strong>
      </p>
    </div>
    <ThumbnailBorderLegend />
    {games.length === 0 ? (
      <p>No games found for this combination.</p>
    ) : (
      <div class="grid">
        {games.map((game) => {
          const reviewed = reviewedGameIds.has(game.id);
          const sTier = sTierGameIds.has(game.id);
          return <GameThumbCard game={game} reviewed={reviewed} sTier={sTier} tierChips={tierChipsByGame.get(game.id) ?? []} />;
        })}
      </div>
    )}
  </main>
</BaseLayout>
