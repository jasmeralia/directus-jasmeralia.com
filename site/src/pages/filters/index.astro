].sort((a, b) => compareLabels(a.label, b.label) || compareLabels(a.href, b.href));
const miscFilterEntriesForDisplay = miscFilterEntries.filter((entry) => !dataCurationMiscLabels.has(entry.label));
const developerStatusEntriesForDisplay = developerStatusEntries.filter((entry) => entry.developer !== "unknown");
const developerPlayedEntriesForDisplay = developerPlayedEntries.filter((entry) => entry.developer !== "unknown");
