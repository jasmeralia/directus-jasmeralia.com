                  <g>
                    <text x={seg.lx} y={seg.ly - 7} text-anchor={seg.anchor} dominant-baseline="middle" fill="#ddd" font-size="11">{seg.label}</text>
                    <text x={seg.lx} y={seg.ly + 7} text-anchor={seg.anchor} dominant-baseline="middle" fill="#aaa" font-size="9.5">{seg.value} · {seg.pct}%</text>
                  </g>
                ))}
              </svg>
            </div>
          </div>
          ) : null}
          {platformExclusivePieSegments.length ? (
          <div class="pie-panel">
            <h3>Download Platform (Exclusives)</h3>
            <div class="pie-wrap">
              <svg class="pie" viewBox={`0 0 ${pieSize} ${pieSize}`} overflow="visible" role="img" aria-label="Download platform exclusive distribution">
                {platformExclusivePieArcs.length === 1 ? (
                  <circle cx={pieCenter} cy={pieCenter} r={pieRadius} fill={platformExclusivePieArcs[0].color}>
                    <title>{platformExclusivePieArcs[0].label} ({platformExclusivePieArcs[0].value})</title>
                  </circle>
                ) : (
                  platformExclusivePieArcs.map((segment) => (
                    <path d={describeArc(pieCenter, pieCenter, pieRadius, segment.start, segment.end)} fill={segment.color}>
                      <title>{segment.label} ({segment.value})</title>
                    </path>
                  ))
                )}
                {platformExclusiveLabeledArcs.map((seg) => (
                  <g>
                    <text x={seg.lx} y={seg.ly - 7} text-anchor={seg.anchor} dominant-baseline="middle" fill="#ddd" font-size="11">{seg.label}</text>
                    <text x={seg.lx} y={seg.ly + 7} text-anchor={seg.anchor} dominant-baseline="middle" fill="#aaa" font-size="9.5">{seg.value} · {seg.pct}%</text>
                  </g>
                ))}
              </svg>
            </div>
          </div>
          ) : null}
        </div>
      ) : null}
      {downloadPlatformCountPieSegments.length || walkthroughPieSegments.length || devLinkPieSegments.length ? (
        <div class="pie-grid">
          {downloadPlatformCountPieSegments.length ? (
          <div class="pie-panel">
            <h3>Download Platform Count</h3>
            <div class="pie-wrap">
              <svg class="pie" viewBox={`0 0 ${pieSize} ${pieSize}`} overflow="visible" role="img" aria-label="Download platform count distribution">
                {downloadPlatformCountPieArcs.length === 1 ? (
                  <circle cx={pieCenter} cy={pieCenter} r={pieRadius} fill={downloadPlatformCountPieArcs[0].color}>
                    <title>{downloadPlatformCountPieArcs[0].label} ({downloadPlatformCountPieArcs[0].value})</title>
                  </circle>
                ) : (
                  downloadPlatformCountPieArcs.map((segment) => (
                    <path d={describeArc(pieCenter, pieCenter, pieRadius, segment.start, segment.end)} fill={segment.color}>
                      <title>{segment.label} ({segment.value})</title>
                    </path>
                  ))
                )}
                {downloadPlatformCountLabeledArcs.map((seg) => (
                  <g>
                    <text x={seg.lx} y={seg.ly - 7} text-anchor={seg.anchor} dominant-baseline="middle" fill="#ddd" font-size="11">{seg.label}</text>
                    <text x={seg.lx} y={seg.ly + 7} text-anchor={seg.anchor} dominant-baseline="middle" fill="#aaa" font-size="9.5">{seg.value} · {seg.pct}%</text>
                  </g>
                ))}
              </svg>
            </div>
          </div>
          ) : null}
          {walkthroughPieSegments.length ? (
          <div class="pie-panel">
            <h3>Walkthrough URL Platform</h3>
            <div class="pie-wrap">
              <svg class="pie" viewBox={`0 0 ${pieSize} ${pieSize}`} overflow="visible" role="img" aria-label="Walkthrough platform distribution">
                {walkthroughPieArcs.length === 1 ? (
                  <circle cx={pieCenter} cy={pieCenter} r={pieRadius} fill={walkthroughPieArcs[0].color}>
                    <title>{walkthroughPieArcs[0].label} ({walkthroughPieArcs[0].value})</title>
                  </circle>
                ) : (
                  walkthroughPieArcs.map((segment) => (
                    <path d={describeArc(pieCenter, pieCenter, pieRadius, segment.start, segment.end)} fill={segment.color}>
                      <title>{segment.label} ({segment.value})</title>
                    </path>
                  ))
                )}
                {walkthroughLabeledArcs.map((seg) => (
                  <g>
                    <text x={seg.lx} y={seg.ly - 7} text-anchor={seg.anchor} dominant-baseline="middle" fill="#ddd" font-size="11">{seg.label}</text>
                    <text x={seg.lx} y={seg.ly + 7} text-anchor={seg.anchor} dominant-baseline="middle" fill="#aaa" font-size="9.5">{seg.value} · {seg.pct}%</text>
                  </g>
                ))}
              </svg>
            </div>
          </div>
          ) : null}
          {devLinkPieSegments.length ? (
            <PieChart title="Developer Link Platform" ariaLabel="Developer link platform distribution" segments={devLinkPieSegments} />
          ) : null}
        </div>
      ) : null}
      {nsfwPieSegments.length ? (
        <div class="pie-grid">
          <div class="pie-panel">
            <h3>SFW / NSFW</h3>
            <div class="pie-wrap">
              <svg class="pie" viewBox={`0 0 ${pieSize} ${pieSize}`} overflow="visible" role="img" aria-label="SFW and NSFW game distribution">
                {nsfwPieArcs.length === 1 ? (
                  <circle cx={pieCenter} cy={pieCenter} r={pieRadius} fill={nsfwPieArcs[0].color}>
                    <title>{nsfwPieArcs[0].label} ({nsfwPieArcs[0].value})</title>
                  </circle>
                ) : (
                  nsfwPieArcs.map((segment) => (
                    <path d={describeArc(pieCenter, pieCenter, pieRadius, segment.start, segment.end)} fill={segment.color}>
                      <title>{segment.label} ({segment.value})</title>
                    </path>
                  ))
                )}
                {nsfwLabeledArcs.map((segment) => (
                  <g>
                    <text x={segment.lx} y={segment.ly - 7} text-anchor={segment.anchor} dominant-baseline="middle" fill="#ddd" font-size="11">{segment.label}</text>
                    <text x={segment.lx} y={segment.ly + 7} text-anchor={segment.anchor} dominant-baseline="middle" fill="#aaa" font-size="9.5">{segment.value} · {segment.pct}%</text>
                  </g>
                ))}
              </svg>
            </div>
          </div>
        </div>
      ) : null}
      <p class="jump-top"><a href="#top">↑ Jump to top</a></p>
    </div>
  </main>
</BaseLayout>
