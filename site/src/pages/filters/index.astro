  { label: "Section Data Present + Incomplete Progress (By Percent)", href: "/filters/section-style/incomplete-progress/index.html", count: partialProgressCount },
  { label: "Section Data Present + No Progress", href: "/filters/section-style/no-progress/index.html", count: sectionNoProgressCount },
  ...genreTierCoverageEntries.map((entry) => ({
