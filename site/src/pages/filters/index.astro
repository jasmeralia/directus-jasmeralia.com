  { label: "Tier List: Completed Games - Missing + Played Status: Completed", href: "/filters/misc/completed-not-in-tier/index.html", count: completedNotInTierCount },
  { label: "Omnibus Games", href: "/filters/misc/omnibus-games/index.html", count: omnibusGamesCount },
  { label: "Cover Art - Placeholder Image", href: "/filters/misc/placeholder-covers/index.html", count: placeholderCoverCount },
  { label: "Steam Family Sharing Disabled", href: "/filters/misc/steam-family-sharing-disabled/index.html", count: familySharingDisabledCount },
  { label: "AVN - Version Mismatches", href: "/filters/misc/version-mismatches/index.html", count: versionMismatchCount },
  ...walkthroughFilterEntries.map((entry) => ({
