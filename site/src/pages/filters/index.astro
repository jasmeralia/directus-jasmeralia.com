---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PieChart from "../../components/PieChart.astro";
import { directusFetchItems, directusFieldChoiceMap, directusFieldChoices, isFamilySharingDisabled } from "../../lib/directus";
import { getUrlPlatform, downloadLinks, isMissingDownloadLink, walkthroughLinks, walkthroughTextNotes, hasSteamDownloadLink } from "../../lib/download-link";
import { hasMissingSectionData, isCurrentlyCompleteGame, isIncompleteGame } from "../../lib/avn-filters";
import { bundleProgressSummary, effectiveSectionStyle, isSectionDataPresentNoProgress, sectionDataState } from "../../lib/game-bundles";
import { GAME_THUMB_FIELDS } from "../../lib/game-fields";
import { sectionProgressSummary } from "../../lib/game-sections";
import { hasVersionMismatch } from "../../lib/game-versions";
import { expandGenreSlugs, GENRE_SUPERSETS, hasGenreMembership, normalizeGenreSlugs } from "../../lib/genre-supersets";
import { formatUnknown, compareLabels } from "../../lib/list-format";
import { CONTENT_RATING_META, contentRating, hasGenreSlug, isGameNsfw } from "../../lib/nsfw";
import {
  WALKTHROUGH_KIND_LABEL,
  WALKTHROUGH_KINDS,
  type WalkthroughKind,
} from "../../lib/walkthrough-link";

const engines = await directusFetchItems("engines", {
  fields: ["slug", "title", "engine_type"],
  limit: -1,
});
const genres = await directusFetchItems("genres", {
  fields: ["slug", "name", "nsfw"],
  limit: -1,
});
const developers = await directusFetchItems("developers", {
  fields: ["slug", "name"],
  limit: -1,
});
const tierLists = await directusFetchItems("tier_lists", {
  fields: ["id", "title", "status"],
  limit: -1,
});
const [gameStatusLabels, playerStatusLabels, sectionStyleLabels] = await Promise.all([
  directusFieldChoiceMap("games", "game_status"),
  directusFieldChoiceMap("games", "player_status"),
  directusFieldChoiceMap("games", "section_style"),
]);
const gameStatusLabel = (value) => gameStatusLabels.get(value) ?? labelize(value);
const playerStatusLabel = (value) => playerStatusLabels.get(value) ?? labelize(value);
const games = await directusFetchItems("games", {
  fields: [
    "id",
    "slug",
    "game_status",
    "player_status",
    "family_sharing",
    "nsfw",
    "cover_is_placeholder",
    "engines.engines_id.slug",
    "genres.genres_id.slug",
    "genres.genres_id.nsfw",
    "developers.developers_id.slug",
    "links.id",
    "links.url",
    "links.kind",
    "links.sort",
    "section_style",
    "sections.id",
    "bundle_members.id",
    "bundle_members.section_data_status",
  ],
  limit: -1,
});
const versions = await directusFetchItems("game_versions", {
  fields: ["id", "games_id", "source", "reported_version", "comparison_override", "source_reference", "installation_key", "is_current"],
  limit: -1,
});
const versionsByGame = new Map();
for (const version of versions) {
  const gameId = typeof version.games_id === "object" ? version.games_id?.id : version.games_id;
  if (gameId == null) continue;
  const rows = versionsByGame.get(gameId) ?? [];
  rows.push(version);
  versionsByGame.set(gameId, rows);
}
for (const game of games) game.versions = versionsByGame.get(game.id) ?? [];

const engineLabel = new Map();
for (const engine of engines ?? []) {
  if (engine?.slug) engineLabel.set(engine.slug, engine.title ?? engine.slug);
}
const genreLabel = new Map();
for (const genre of genres ?? []) {
  if (genre?.slug) genreLabel.set(genre.slug, genre.name ?? genre.slug);
}
const developerLabel = new Map();
for (const developer of developers ?? []) {
  if (developer?.slug) {
    developerLabel.set(developer.slug, developer.name ?? developer.slug);
  }
}

const engineGenreCounts = new Map();
const engineGenreTotalCounts = new Map();
const engineStatusCounts = new Map();
const engineStatusValues = new Map();
const developerStatusCounts = new Map();
const developerStatusValues = new Map();
const genreStatusCounts = new Map();
const genreStatusTotalCounts = new Map();
const genreStatusValues = new Map();
const enginePlayedCounts = new Map();
const enginePlayedValues = new Map();
const developerPlayedCounts = new Map();
const developerPlayedValues = new Map();
const genrePlayedCounts = new Map();
const genrePlayedTotalCounts = new Map();
const genrePlayedValues = new Map();
const gameStatusPlayedCounts = new Map();
const sectionDataPlayedCounts = new Map();
const sectionDataGenreCounts = new Map();
const sectionDataGenreTotalCounts = new Map();
const contentRatingPlayedCounts = new Map();
const contentRatingGameStatusCounts = new Map();
const contentRatingSectionStyleCounts = new Map();
const sectionStyleGenreCounts = new Map();
const sectionStyleGenreTotalCounts = new Map();

for (const game of games ?? []) {
  const engineSlugs =
    (game.engines ?? []).map((entry) => entry?.engines_id?.slug).filter(Boolean);
  const rawGenreSlugs =
    (game.genres ?? []).map((entry) => entry?.genres_id?.slug).filter(Boolean);
  const distinctGenreSlugs = normalizeGenreSlugs(rawGenreSlugs);
  const expandedGenreSlugs = expandGenreSlugs(rawGenreSlugs);
  const developerSlugs =
    (game.developers ?? []).map((entry) => entry?.developers_id?.slug).filter(Boolean);

  const enginesForGame = engineSlugs.length ? engineSlugs : ["unknown"];
  const totalGenresForGame = expandedGenreSlugs.length ? expandedGenreSlugs : ["unknown"];
  const distinctGenresForGame = distinctGenreSlugs.length ? distinctGenreSlugs : ["unknown"];
  const developersForGame = developerSlugs.length ? developerSlugs : ["unknown"];
  const sectionState = sectionDataState(game);

  for (const genre of totalGenresForGame) {
    const key = `${sectionState}::${genre}`;
    if (distinctGenresForGame.includes(genre)) {
      sectionDataGenreCounts.set(key, (sectionDataGenreCounts.get(key) || 0) + 1);
    }
    sectionDataGenreTotalCounts.set(key, (sectionDataGenreTotalCounts.get(key) || 0) + 1);
  }

  for (const engine of enginesForGame) {
    for (const genre of distinctGenresForGame) {
      const key = `${engine}::${genre}`;
      engineGenreCounts.set(key, (engineGenreCounts.get(key) || 0) + 1);
    }
  }
  for (const engine of enginesForGame) {
    for (const genre of totalGenresForGame) {
      const key = `${engine}::${genre}`;
      engineGenreTotalCounts.set(key, (engineGenreTotalCounts.get(key) || 0) + 1);
    }
  }

  if (game.game_status) {
    for (const engine of enginesForGame) {
      const key = `${engine}::${game.game_status}`;
      engineStatusCounts.set(key, (engineStatusCounts.get(key) || 0) + 1);
      if (!engineStatusValues.has(engine)) {
        engineStatusValues.set(engine, new Set());
      }
      engineStatusValues.get(engine).add(game.game_status);
    }
    for (const developer of developersForGame) {
      const key = `${developer}::${game.game_status}`;
      developerStatusCounts.set(key, (developerStatusCounts.get(key) || 0) + 1);
      if (!developerStatusValues.has(developer)) {
        developerStatusValues.set(developer, new Set());
      }
      developerStatusValues.get(developer).add(game.game_status);
    }
    for (const genre of totalGenresForGame) {
      const key = `${genre}::${game.game_status}`;
      if (distinctGenresForGame.includes(genre)) {
        genreStatusCounts.set(key, (genreStatusCounts.get(key) || 0) + 1);
      }
      if (!genreStatusValues.has(genre)) {
        genreStatusValues.set(genre, new Set());
      }
      genreStatusValues.get(genre).add(game.game_status);
    }
    for (const genre of totalGenresForGame) {
      const key = `${genre}::${game.game_status}`;
      genreStatusTotalCounts.set(key, (genreStatusTotalCounts.get(key) || 0) + 1);
    }
    const statusRatingKey = `${contentRating(game)}::${game.game_status}`;
    contentRatingGameStatusCounts.set(statusRatingKey, (contentRatingGameStatusCounts.get(statusRatingKey) || 0) + 1);
  }

  const effectiveStyle = effectiveSectionStyle(game);
  if (effectiveStyle) {
    const styleRatingKey = `${contentRating(game)}::${effectiveStyle}`;
    contentRatingSectionStyleCounts.set(styleRatingKey, (contentRatingSectionStyleCounts.get(styleRatingKey) || 0) + 1);
    for (const genre of totalGenresForGame) {
      const key = `${effectiveStyle}::${genre}`;
      if (distinctGenresForGame.includes(genre)) {
        sectionStyleGenreCounts.set(key, (sectionStyleGenreCounts.get(key) || 0) + 1);
      }
    }
    for (const genre of totalGenresForGame) {
      const key = `${effectiveStyle}::${genre}`;
      sectionStyleGenreTotalCounts.set(key, (sectionStyleGenreTotalCounts.get(key) || 0) + 1);
    }
  }

  if (game.player_status) {
    if (game.game_status) {
      const key = `${game.game_status}::${game.player_status}`;
      gameStatusPlayedCounts.set(key, (gameStatusPlayedCounts.get(key) || 0) + 1);
    }
    for (const engine of enginesForGame) {
      const key = `${engine}::${game.player_status}`;
      enginePlayedCounts.set(key, (enginePlayedCounts.get(key) || 0) + 1);
      if (!enginePlayedValues.has(engine)) {
        enginePlayedValues.set(engine, new Set());
      }
      enginePlayedValues.get(engine).add(game.player_status);
    }
    for (const developer of developersForGame) {
      const key = `${developer}::${game.player_status}`;
      developerPlayedCounts.set(key, (developerPlayedCounts.get(key) || 0) + 1);
      if (!developerPlayedValues.has(developer)) {
        developerPlayedValues.set(developer, new Set());
      }
      developerPlayedValues.get(developer).add(game.player_status);
    }
    for (const genre of totalGenresForGame) {
      const key = `${genre}::${game.player_status}`;
      if (distinctGenresForGame.includes(genre)) {
        genrePlayedCounts.set(key, (genrePlayedCounts.get(key) || 0) + 1);
      }
      if (!genrePlayedValues.has(genre)) {
        genrePlayedValues.set(genre, new Set());
      }
      genrePlayedValues.get(genre).add(game.player_status);
    }
    for (const genre of totalGenresForGame) {
      const key = `${genre}::${game.player_status}`;
      genrePlayedTotalCounts.set(key, (genrePlayedTotalCounts.get(key) || 0) + 1);
    }
    const sectionKey = `${sectionState}::${game.player_status}`;
    sectionDataPlayedCounts.set(sectionKey, (sectionDataPlayedCounts.get(sectionKey) || 0) + 1);
    const ratingKey = `${contentRating(game)}::${game.player_status}`;
    contentRatingPlayedCounts.set(ratingKey, (contentRatingPlayedCounts.get(ratingKey) || 0) + 1);
  }
}

const labelize = (value) =>
  value ? value.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()) : "";
const unknownLast = (a, b, key) => {
  const aUnknown = a[key]?.startsWith("<Unknown ");
  const bUnknown = b[key]?.startsWith("<Unknown ");
  if (aUnknown !== bUnknown) return aUnknown ? 1 : -1;
  return 0;
};
const isSupersetGenre = (slug) =>
  Object.prototype.hasOwnProperty.call(GENRE_SUPERSETS, slug);

const engineGenreEntries = Array.from(engineGenreTotalCounts.entries())
  .map(([key, totalCount]) => {
    const [engine, genre] = key.split("::");
    return {
      engine,
      genre,
      count: engineGenreCounts.get(key) || 0,
      totalCount,
      engineLabel: engineLabel.get(engine) ?? formatUnknown(engine, "Engine"),
      genreLabel: genreLabel.get(genre) ?? formatUnknown(genre, "Genre"),
    };
  })
  .sort((a, b) =>
    unknownLast(a, b, "engineLabel") ||
    compareLabels(a.engineLabel, b.engineLabel) ||
    unknownLast(a, b, "genreLabel") ||
    compareLabels(a.genreLabel, b.genreLabel));


const engineStatusEntries = Array.from(engineStatusCounts.entries())
  .map(([key, count]) => {
    const [engine, status] = key.split("::");
    return {
      engine,
      status,
      count,
      engineLabel: engineLabel.get(engine) ?? formatUnknown(engine, "Engine"),
      statusLabel: gameStatusLabel(status),
    };
  })
  .filter((entry) => (engineStatusValues.get(entry.engine)?.size ?? 0) > 1)
  .sort((a, b) =>
    unknownLast(a, b, "engineLabel") ||
    compareLabels(a.engineLabel, b.engineLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const developerStatusEntries = Array.from(developerStatusCounts.entries())
  .map(([key, count]) => {
    const [developer, status] = key.split("::");
    return {
      developer,
      status,
      count,
      developerLabel: developerLabel.get(developer) ?? formatUnknown(developer, "Developer"),
      statusLabel: gameStatusLabel(status),
    };
  })
  .filter((entry) => (developerStatusValues.get(entry.developer)?.size ?? 0) > 1)
  .sort((a, b) =>
    unknownLast(a, b, "developerLabel") ||
    compareLabels(a.developerLabel, b.developerLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const genreStatusEntries = Array.from(genreStatusTotalCounts.entries())
  .map(([key, totalCount]) => {
    const [genre, status] = key.split("::");
    return {
      genre,
      status,
      count: genreStatusCounts.get(key) || 0,
      totalCount,
      genreLabel: genreLabel.get(genre) ?? formatUnknown(genre, "Genre"),
      statusLabel: gameStatusLabel(status),
    };
  })
  .filter((entry) => (genreStatusValues.get(entry.genre)?.size ?? 0) > 1)
  .sort((a, b) =>
    unknownLast(a, b, "genreLabel") ||
    compareLabels(a.genreLabel, b.genreLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const enginePlayedEntries = Array.from(enginePlayedCounts.entries())
  .map(([key, count]) => {
    const [engine, status] = key.split("::");
    return {
      engine,
      status,
      count,
      engineLabel: engineLabel.get(engine) ?? formatUnknown(engine, "Engine"),
      statusLabel: playerStatusLabel(status),
    };
  })
  .filter((entry) => (enginePlayedValues.get(entry.engine)?.size ?? 0) > 1)
  .sort((a, b) =>
    unknownLast(a, b, "engineLabel") ||
    compareLabels(a.engineLabel, b.engineLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const developerPlayedEntries = Array.from(developerPlayedCounts.entries())
  .map(([key, count]) => {
    const [developer, status] = key.split("::");
    return {
      developer,
      status,
      count,
      developerLabel: developerLabel.get(developer) ?? formatUnknown(developer, "Developer"),
      statusLabel: playerStatusLabel(status),
    };
  })
  .filter((entry) => (developerPlayedValues.get(entry.developer)?.size ?? 0) > 1)
  .sort((a, b) =>
    unknownLast(a, b, "developerLabel") ||
    compareLabels(a.developerLabel, b.developerLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const genrePlayedEntries = Array.from(genrePlayedTotalCounts.entries())
  .map(([key, totalCount]) => {
    const [genre, status] = key.split("::");
    return {
      genre,
      status,
      count: genrePlayedCounts.get(key) || 0,
      totalCount,
      genreLabel: genreLabel.get(genre) ?? formatUnknown(genre, "Genre"),
      statusLabel: playerStatusLabel(status),
    };
  })
  .filter((entry) => (genrePlayedValues.get(entry.genre)?.size ?? 0) > 1)
  .sort((a, b) =>
    unknownLast(a, b, "genreLabel") ||
    compareLabels(a.genreLabel, b.genreLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const gameStatusPlayedEntries = Array.from(gameStatusPlayedCounts.entries())
  .map(([key, count]) => {
    const [gameStatus, playerStatus] = key.split("::");
    return {
      gameStatus,
      playerStatus,
      count,
      gameStatusLabel: gameStatusLabel(gameStatus),
      playerStatusLabel: playerStatusLabel(playerStatus),
    };
  })
  .sort((a, b) =>
    compareLabels(a.gameStatusLabel, b.gameStatusLabel) ||
    compareLabels(a.playerStatusLabel, b.playerStatusLabel));

const sectionDataPlayedEntries = Array.from(sectionDataPlayedCounts.entries())
  .map(([key, count]) => {
    const [state, status] = key.split("::");
    return {
      state,
      status,
      count,
      stateLabel: labelize(state),
      statusLabel: playerStatusLabel(status),
    };
  })
  .sort((a, b) =>
    compareLabels(a.stateLabel, b.stateLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const sectionDataGenreEntries = Array.from(sectionDataGenreTotalCounts.entries())
  .map(([key, totalCount]) => {
    const [state, genre] = key.split("::");
    return {
      state,
      genre,
      count: sectionDataGenreCounts.get(key) || 0,
      totalCount,
      stateLabel: labelize(state),
      genreLabel: genreLabel.get(genre) ?? formatUnknown(genre, "Genre"),
    };
  })
  .sort((a, b) =>
    compareLabels(a.stateLabel, b.stateLabel) ||
    unknownLast(a, b, "genreLabel") ||
    compareLabels(a.genreLabel, b.genreLabel));

const contentRatingPlayedEntries = Array.from(contentRatingPlayedCounts.entries())
  .map(([key, count]) => {
    const [rating, status] = key.split("::");
    return {
      rating,
      status,
      count,
      ratingLabel: CONTENT_RATING_META[rating]?.label ?? rating,
      statusLabel: playerStatusLabel(status),
    };
  })
  .sort((a, b) =>
    compareLabels(a.ratingLabel, b.ratingLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const INCOMPLETE_STATUSES = new Set(["not_started", "plan_to_play", "in_progress", "on_hold", "waiting_for_update"]);
const INCOMPLETE_EXCLUDED_GAME_STATUSES = new Set(["unreleased", "abandoned"]);
const avnIncompleteByGenre = new Map<string, number>();
for (const game of games ?? []) {
  if (!game.player_status || !INCOMPLETE_STATUSES.has(game.player_status)) continue;
  if (INCOMPLETE_EXCLUDED_GAME_STATUSES.has(game.game_status)) continue;
  const slugs = (game.genres ?? []).map((entry) => entry?.genres_id?.slug).filter(Boolean);
  if (!slugs.includes("avn")) continue;
  for (const slug of slugs) {
    if (slug === "avn") continue;
    avnIncompleteByGenre.set(slug, (avnIncompleteByGenre.get(slug) ?? 0) + 1);
  }
}

const hasAvnGenre = (game) => hasGenreSlug(game, "avn");
const nsfwCount = (games ?? []).filter((game) => isGameNsfw(game)).length;
const sfwCount = (games ?? []).length - nsfwCount;
const contentRatingEntries = [
  { rating: "sfw", label: "SFW", count: sfwCount },
  { rating: "nsfw", label: "NSFW", count: nsfwCount },
];

const sectionStyleChoices = await directusFieldChoices("games", "section_style");
const sectionStyleCounts = new Map();
for (const game of games ?? []) {
  const style = effectiveSectionStyle(game);
  if (style) sectionStyleCounts.set(style, (sectionStyleCounts.get(style) ?? 0) + 1);
}
const sectionStyleEntries = sectionStyleChoices.map(({ value: style, label }) => ({
  style,
  label,
  count: sectionStyleCounts.get(style) ?? 0,
}));

const contentRatingSectionStyleEntries = Array.from(contentRatingSectionStyleCounts.entries())
  .map(([key, count]) => {
    const [rating, style] = key.split("::");
    return {
      rating,
      style,
      count,
      ratingLabel: CONTENT_RATING_META[rating]?.label ?? rating,
      styleLabel: sectionStyleLabels.get(style) ?? style,
    };
  })
  .sort((a, b) =>
    compareLabels(a.ratingLabel, b.ratingLabel) ||
    compareLabels(a.styleLabel, b.styleLabel));

const contentRatingGameStatusEntries = Array.from(contentRatingGameStatusCounts.entries())
  .map(([key, count]) => {
    const [rating, status] = key.split("::");
    return {
      rating,
      status,
      count,
      ratingLabel: CONTENT_RATING_META[rating]?.label ?? rating,
      statusLabel: gameStatusLabel(status),
    };
  })
  .sort((a, b) =>
    compareLabels(a.ratingLabel, b.ratingLabel) ||
    compareLabels(a.statusLabel, b.statusLabel));

const sectionStyleGenreEntries = Array.from(sectionStyleGenreTotalCounts.entries())
  .map(([key, totalCount]) => {
    const [style, genre] = key.split("::");
    return {
      style,
      genre,
      count: sectionStyleGenreCounts.get(key) || 0,
      totalCount,
      styleLabel: sectionStyleLabels.get(style) ?? style,
      genreLabel: genreLabel.get(genre) ?? formatUnknown(genre, "Genre"),
    };
  })
  .sort((a, b) =>
    compareLabels(a.styleLabel, b.styleLabel) ||
    unknownLast(a, b, "genreLabel") ||
    compareLabels(a.genreLabel, b.genreLabel));

const nsfwNotAvnCount = (games ?? []).filter(
  (game) => isGameNsfw(game) && !hasAvnGenre(game),
).length;
const hasGslLink = (game) => (game?.links ?? []).some((l) => l.kind === "gamestorylog");
const avnMissingGamestorylogCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && !hasGslLink(game),
).length;
const avnWithGamestorylogCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && hasGslLink(game),
).length;
const nonAvnWithGamestorylogCount = (games ?? []).filter(
  (game) => !hasAvnGenre(game) && hasGslLink(game),
).length;
const missingDownloadLinkCount = (games ?? []).filter(isMissingDownloadLink).length;
const avnMissingWalkthroughCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && walkthroughLinks(game?.links).length === 0,
).length;
const hasHaremGenre = (game) =>
  (game?.genres ?? []).some((entry) => entry?.genres_id?.slug === "harem");
const avnHaremCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && hasHaremGenre(game),
).length;
const avnNotHaremCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && !hasHaremGenre(game),
).length;
const hasSandboxGenre = (game) =>
  (game?.genres ?? []).some((entry) => entry?.genres_id?.slug === "sandbox");
const avnSandboxCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && hasSandboxGenre(game),
).length;
const AVN_BACKLOG_EXCLUDED_PLAYER_STATUSES = new Set(["did_not_finish", "completed", "in_progress", "waiting_for_update"]);
const avnBacklogCount = (games ?? []).filter(
  (game) =>
    hasAvnGenre(game) &&
    game?.game_status !== "abandoned" &&
    !AVN_BACKLOG_EXCLUDED_PLAYER_STATUSES.has(game?.player_status),
).length;
const AVN_CURRENTLY_COMPLETE_PLAYER_STATUSES = new Set(["completed", "waiting_for_update"]);
const avnCurrentlyCompleteCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && AVN_CURRENTLY_COMPLETE_PLAYER_STATUSES.has(game?.player_status),
).length;
const avnMissingSectionIncompleteCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && isIncompleteGame(game) && hasMissingSectionData(game),
).length;
const avnMissingSectionCurrentlyCompleteCount = (games ?? []).filter(
  (game) => hasAvnGenre(game) && isCurrentlyCompleteGame(game) && hasMissingSectionData(game),
).length;
const getGameGenreSlugs = (game) =>
  (game?.genres ?? []).map((entry) => entry?.genres_id?.slug).filter(Boolean);
const hasVnGenre = (game) => hasGenreMembership(getGameGenreSlugs(game), "visual-novel");
// A rendering/art engine (e.g. Daz 3D) doesn't preclude a game engine like
// Ren'py or RPGM underneath it, so only "gaming" engines (as opposed to
// "rendering" engines) count as "has engine data" for VN purposes.
const GAMING_ENGINE_SLUGS = new Set(
  (engines ?? []).filter((e) => e?.engine_type === "gaming").map((e) => e.slug),
);
const hasVnEngine = (game) =>
  (game?.engines ?? []).some((entry) => GAMING_ENGINE_SLUGS.has(entry?.engines_id?.slug));
const vnMissingEngineCount = (games ?? []).filter(
  (game) => hasVnGenre(game) && game?.game_status !== "unreleased" && !hasVnEngine(game),
).length;
const RENDERING_ENGINE_SLUGS = new Set(
