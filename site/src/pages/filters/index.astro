  ...enginePlayedEntries
    .filter((entry) => entry.engine === "unknown")
    .map((entry) => ({
      label: `Unknown Engine + Played Status: ${entry.statusLabel}`,
      href: `/filters/engine/unknown/played_status/${entry.status}/index.html`,
      count: entry.count,
    })),
  ...genreStatusEntries
    .filter((entry) => entry.genre === "unknown")
    .map((entry) => ({
      label: `Unknown Genre + Game Status: ${entry.statusLabel}`,
      href: `/filters/genre/unknown/game_status/${entry.status}/index.html`,
      count: entry.count,
    })),
  ...genrePlayedEntries
    .filter((entry) => entry.genre === "unknown")
    .map((entry) => ({
      label: `Unknown Genre + Played Status: ${entry.statusLabel}`,
      href: `/filters/genre/unknown/played_status/${entry.status}/index.html`,
      count: entry.count,
    })),
  ...sectionDataGenreEntries
    .filter((entry) => entry.genre === "unknown")
    .map((entry) => ({
      label: `Section Data ${entry.stateLabel} + Genre: Unknown`,
      href: `/filters/section-data/${entry.state}/genre/unknown/index.html`,
      count: entry.count,
