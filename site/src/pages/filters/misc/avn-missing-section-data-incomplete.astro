---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../components/GameThumbCard.astro";
import { directusFetchItems, getReviewedGameIds, getSTierGameIds, getTierChipsByGameId } from "../../../lib/directus";
import { csvDataUri, gamesToCsv } from "../../../lib/csv";
import { isIncompleteGame, hasMissingSectionData } from "../../../lib/avn-filters";
import { GAME_THUMB_FIELDS } from "../../../lib/game-fields";
import { sortByTitle } from "../../../lib/list-format";

const games = sortByTitle(await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  filter: { genres: { genres_id: { slug: { _eq: "avn" } } } },
  limit: -1,
}));

const filteredGames = (games ?? []).filter(
  (game) => isIncompleteGame(game) && hasMissingSectionData(game),
);

const gameIds = filteredGames
  .map((game) => game.id)
  .filter((id) => typeof id === "number");
const [reviewedGameIds, sTierGameIds, tierChipsByGame] = await Promise.all([
  getReviewedGameIds(gameIds),
  getSTierGameIds(gameIds),
  getTierChipsByGameId(gameIds),
]);

const csvName = "avn-missing-section-data-incomplete.csv";
const csvHref = csvDataUri(gamesToCsv(filteredGames));
---

<BaseLayout title="Filters | AVN + Missing Section Data + Incomplete">
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title="AVN + Missing Section Data + Incomplete" count={filteredGames.length} csvHref={csvHref} csvName={csvName} />
      <p>AVN games with no section data (no chapters or quests, and no tracked included games) whose played status is incomplete (not started, plan to play, in progress, on hold, or waiting for update), excluding unreleased and abandoned games.</p>
    </div>
    <ThumbnailBorderLegend />
    {filteredGames.length === 0 ? (
      <p>No games match.</p>
    ) : (
      <div class="grid">
        {filteredGames.map((game) => {
          const reviewed = reviewedGameIds.has(game.id);
          const sTier = sTierGameIds.has(game.id);
          return <GameThumbCard game={game} reviewed={reviewed} sTier={sTier} tierChips={tierChipsByGame.get(game.id) ?? []} />;
        })}
      </div>
    )}
  </main>
</BaseLayout>
