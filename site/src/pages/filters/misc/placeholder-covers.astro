---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../components/GameThumbCard.astro";
import { directusFetchItems, getReviewedGameIds, getSTierGameIds } from "../../../lib/directus";
import { csvDataUri, gamesToCsv } from "../../../lib/csv";
import { GAME_THUMB_FIELDS } from "../../../lib/game-fields";
import { compareLabels } from "../../../lib/list-format";

const allGames = await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  limit: -1,
});

const filteredGames = (allGames ?? [])
  .filter((game) => game.cover_is_placeholder === true)
  .sort((a, b) => compareLabels(a.title, b.title));

const gameIds = filteredGames.map((game) => game.id).filter((id) => typeof id === "number");
const [reviewedGameIds, sTierGameIds] = await Promise.all([
  getReviewedGameIds(gameIds),
  getSTierGameIds(gameIds),
]);

const csvName = "placeholder-covers.csv";
const csvHref = csvDataUri(gamesToCsv(filteredGames));
---

<BaseLayout title="Filters | Placeholder Covers">
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title="Placeholder Covers" count={filteredGames.length} csvHref={csvHref} csvName={csvName} />
      <p>Games currently using generated placeholder cover art while final cover art is unavailable.</p>
    </div>
    <ThumbnailBorderLegend />
    {filteredGames.length === 0 ? (
      <p>No games are using placeholder cover art.</p>
    ) : (
      <div class="grid">
        {filteredGames.map((game) => {
          const reviewed = reviewedGameIds.has(game.id);
          const sTier = sTierGameIds.has(game.id);
          return <GameThumbCard game={game} reviewed={reviewed} sTier={sTier} />;
        })}
      </div>
    )}
  </main>
</BaseLayout>
