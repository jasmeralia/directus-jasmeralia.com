---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../components/GameThumbCard.astro";
import { directusFetchItems, getSTierGameIds } from "../../../lib/directus";
import { csvDataUri, gamesToCsv } from "../../../lib/csv";
import { GAME_THUMB_FIELDS } from "../../../lib/game-fields";
import { sortByTitle } from "../../../lib/list-format";

const games = sortByTitle(await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  filter: { player_status: { _eq: "in_progress" } },
  limit: -1,
}));

const inProgressGameIds = games
  .map((game) => game.id)
  .filter((id) => typeof id === "number");
const gamesWithSections = new Set<number>();
if (inProgressGameIds.length) {
  const sectionRows = await directusFetchItems<{
    games_id?: number | { id?: number } | null;
  }>("game_sections", {
    fields: ["games_id"],
    filter: { games_id: { _in: inProgressGameIds } },
    limit: -1,
  });
  for (const row of sectionRows ?? []) {
    const id = typeof row.games_id === "number"
      ? row.games_id
      : row.games_id?.id;
    if (typeof id === "number") gamesWithSections.add(id);
  }
}

const filteredGames = games.filter((game) => !gamesWithSections.has(game.id));
const gameIds = filteredGames
  .map((game) => game.id)
  .filter((id) => typeof id === "number");
const sTierGameIds = await getSTierGameIds(gameIds);
const reviewedGameIds = new Set<number>();
if (gameIds.length) {
  const reviews = await directusFetchItems<{ game?: { id?: number } }>("reviews", {
    fields: ["game.id"],
    filter: { status: { _eq: "published" }, game: { _in: gameIds } },
    limit: -1,
  });
  for (const review of reviews ?? []) {
    const id = review.game?.id;
    if (typeof id === "number") reviewedGameIds.add(id);
  }
}

const csvName = "games-missing-sections.csv";
const csvHref = csvDataUri(gamesToCsv(filteredGames));
---

<BaseLayout title="Filters | In Progress + Missing Sections">
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title="In Progress + Missing Sections" count={filteredGames.length} csvHref={csvHref} csvName={csvName} />
      <p>In-progress games that do not have any section tracking rows.</p>
    </div>
    <ThumbnailBorderLegend />
    {filteredGames.length === 0 ? (
      <p>No in-progress games are missing sections.</p>
    ) : (
      <div class="grid">
        {filteredGames.map((game) => {
          const reviewed = reviewedGameIds.has(game.id);
          const sTier = sTierGameIds.has(game.id);
          return <GameThumbCard game={game} reviewed={reviewed} sTier={sTier} />;
        })}
      </div>
    )}
  </main>
</BaseLayout>
