---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { directusFetchItems, directusFieldChoiceMap } from "../../../lib/directus";
import { downloadLinksByDomain, getLinkMeta } from "../../../lib/download-link";
import { compareInstallToGsl, effectiveVersion, formatTrackedVersion, hasVersionMismatch } from "../../../lib/game-versions";
import { sortByTitle } from "../../../lib/list-format";

const allGames = await directusFetchItems("games", {
  fields: [
    "id",
    "title",
    "slug",
    "player_status",
    "game_status",
    "links.id",
    "links.url",
    "links.label",
    "links.kind",
    "links.sort",
  ],
  limit: -1,
});
const versions = await directusFetchItems("game_versions", {
  fields: ["id", "games_id", "source", "reported_version", "comparison_override", "override_reason", "source_reference", "installation_key", "is_current"],
  limit: -1,
});
const playerStatusLabels = await directusFieldChoiceMap("games", "player_status");
const versionsByGame = new Map();
for (const version of versions) {
  const gameId = typeof version.games_id === "object" ? version.games_id?.id : version.games_id;
  if (gameId == null) continue;
  const rows = versionsByGame.get(gameId) ?? [];
  rows.push(version);
  versionsByGame.set(gameId, rows);
}
for (const game of allGames) game.versions = versionsByGame.get(game.id) ?? [];

const games = sortByTitle((allGames ?? []).filter(hasVersionMismatch));
const description = `${games.length} games have differing tracked version values across Orion, Typhoon, and GameStoryLog.`;

// Same palette as the status ring on GameThumbCard. not_started is the
// baseline and draws no marker; plan_to_play gets a hollow ring.
const STATUS_COLORS = {
  plan_to_play: "#7a7a7a",
  in_progress: "#70b7ff",
  on_hold: "#e8a020",
  waiting_for_update: "#1f6b2b",
  did_not_finish: "#d14b4b",
  completed: "#c0c0c0",
};
const STATUS_ORDER = ["plan_to_play", "in_progress", "on_hold", "waiting_for_update", "did_not_finish", "completed"];
const statusLabel = (status) => playerStatusLabels.get(status) ?? status;

const COMPARISON_LABELS = {
  current: "Up to date with GameStoryLog",
  behind: "Behind GameStoryLog",
  preview: "Demo or preview install",
  unrecorded: "No version recorded",
};

const rows = games.map((game) => {
  const current = (game.versions ?? []).filter((row) => row.is_current !== false);
  const gsl = current.find((row) => row.source === "gsl") ?? null;
  const gslValue = gsl ? effectiveVersion(gsl) : null;
  const gslLink = (game.links ?? []).find((l) => l.kind === "gamestorylog") ?? null;
  const installs = (source) =>
    current
      .filter((row) => row.source === source)
      .map((row) => ({
        version: formatTrackedVersion(row.reported_version),
        comparison: compareInstallToGsl(row, gslValue),
        reference: row.installation_key ? (row.source_reference ?? "installation") : null,
        note: row.comparison_override
          ? `Compared as ${effectiveVersion(row)}${row.override_reason ? ` - ${row.override_reason}` : ""}`
          : null,
      }));
  return {
    game,
    gslValue,
    gslUrl: gslLink?.url ?? null,
    typhoon: installs("typhoon"),
    orion: installs("orion"),
    links: downloadLinksByDomain(game.links).map((link) => ({ url: link.url, meta: getLinkMeta(link) })),
  };
});

const statusesPresent = STATUS_ORDER.filter((status) => games.some((game) => game.player_status === status));
const hasPreview = rows.some((row) => [...row.typhoon, ...row.orion].some((i) => i.comparison === "preview"));
---

<BaseLayout title="Filters | Version Mismatches" description={description}>
  <div slot="head">
    <style>
      main{padding:24px;}
      .list{max-width:1100px;margin:0 auto;}
      .legend{display:flex;flex-wrap:wrap;align-items:center;gap:6px 18px;font-size:.8rem;margin:0 0 10px;opacity:.85;}
      .legend span{display:inline-flex;align-items:center;gap:5px;}
      .grid{border-top:1px solid #222;font-size:.9rem;}
      .row{display:grid;grid-template-columns:minmax(0,2.3fr) minmax(0,1.5fr) minmax(0,1.35fr) minmax(0,1.35fr) 90px;gap:0 12px;align-items:center;min-height:31px;padding:2px 6px;border-bottom:1px solid #222;}
      .row.head{min-height:30px;font-size:.75rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;opacity:.7;background:#141414;}
      .row:not(.head):hover{background:#161616;}
      .cell{min-width:0;display:flex;flex-direction:column;justify-content:center;gap:2px;}
      .line{min-width:0;display:flex;align-items:center;gap:6px;}
      .text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-variant-numeric:tabular-nums;}
      .row a{color:#9aa6ff;text-decoration:none;}
      .row a:visited{color:#9aa6ff;}
      .row a:hover{text-decoration:underline;}
      .title .text{font-weight:600;}
      .title a,.title a:visited{color:inherit;}
      .status-slot{flex:none;width:9px;height:9px;}
      .status-dot{display:block;width:9px;height:9px;border-radius:50%;box-sizing:border-box;}
      .status-dot.is-hollow{background:transparent !important;border:1.5px solid;}
      .na{font-style:italic;font-size:.8rem;opacity:.5;}
      .ref{font-size:.75rem;opacity:.6;}
      .icon{flex:none;width:15px;height:15px;}
      .icon.is-current{color:#3fb96b;}
      .icon.is-behind{color:#e5534b;}
      .icon.is-preview,.icon.is-unrecorded{color:#8a8a8a;}
      .missing{font-style:italic;opacity:.55;}
      .links{display:flex;align-items:center;justify-content:flex-end;gap:.45rem;}
      .links img{width:1.05rem;height:1.05rem;display:block;}
      .links .platform-icon{filter:brightness(0) saturate(100%) invert(67%) sepia(11%) saturate(1832%) hue-rotate(194deg) brightness(97%) contrast(96%);}
      .label{display:none;}
      @media (max-width:760px){
        .row{grid-template-columns:repeat(3,minmax(0,1fr));gap:4px 10px;padding:8px 6px;}
        .row.head{display:none;}
        .row .title{grid-column:1 / 3;}
        .row .links-cell{grid-column:3;}
        .label{display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.04em;opacity:.6;}
      }
    </style>
  </div>
  <main>
    <div class="list">
      <h1>Version Mismatches <span style="opacity:.6;font-size:.8em;">({games.length})</span></h1>
      <p>A game appears here when an active Orion or Typhoon installation is behind the current GameStoryLog version. Every active installation is shown separately.</p>
      {games.length === 0 ? (
        <p>No tracked game versions currently differ.</p>
      ) : (
        <>
          <svg width="0" height="0" style="position:absolute" aria-hidden="true">
            <defs>
              <g id="vm-current"><circle cx="8" cy="8" r="7.5" fill="currentColor" opacity=".18"/><path d="M4.6 8.3l2.3 2.3 4.5-4.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></g>
              <g id="vm-behind"><circle cx="8" cy="8" r="7.5" fill="currentColor" opacity=".18"/><path d="M5.3 5.3l5.4 5.4M10.7 5.3l-5.4 5.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></g>
              <g id="vm-preview"><circle cx="8" cy="8" r="7.5" fill="currentColor" opacity=".18"/><path d="M5 8h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></g>
            </defs>
          </svg>
          <div class="legend" aria-label="Legend">
            <span><svg class="icon is-current" viewBox="0 0 16 16" aria-hidden="true"><use href="#vm-current"/></svg> up to date with GSL</span>
            <span><svg class="icon is-behind" viewBox="0 0 16 16" aria-hidden="true"><use href="#vm-behind"/></svg> behind GSL</span>
            {hasPreview ? <span><svg class="icon is-preview" viewBox="0 0 16 16" aria-hidden="true"><use href="#vm-preview"/></svg> demo or preview</span> : null}
            <span><span class="na">N/A</span> not installed there</span>
            {statusesPresent.map((status) => (
              <span>
                <span class="status-slot"><span class:list={["status-dot", { "is-hollow": status === "plan_to_play" }]} style={`background:${STATUS_COLORS[status]};border-color:${STATUS_COLORS[status]};`}></span></span>
                {statusLabel(status)}
              </span>
            ))}
          </div>
          <div class="grid" role="table" aria-label="Version mismatches">
            <div class="row head" role="row">
              <div role="columnheader">Game</div>
              <div role="columnheader">GameStoryLog</div>
              <div role="columnheader">Typhoon</div>
              <div role="columnheader">Orion</div>
              <div role="columnheader" style="text-align:right">Get</div>
            </div>
            {rows.map((row) => {
              const status = row.game.player_status;
              return (
                <div class="row" role="row">
                  <div class="cell title" role="cell">
                    <div class="line">
                      <span class="status-slot">
                        {STATUS_COLORS[status] ? (
                          <span
                            class:list={["status-dot", { "is-hollow": status === "plan_to_play" }]}
                            style={`background:${STATUS_COLORS[status]};border-color:${STATUS_COLORS[status]};`}
                            title={statusLabel(status)}
                          ></span>
                        ) : null}
                      </span>
                      <a class="text" href={`/games/${row.game.slug}/index.html`} title={row.game.title}>{row.game.title}</a>
                    </div>
                  </div>
                  <div class="cell" role="cell">
                    <span class="label">GameStoryLog</span>
                    <div class="line">
                      {row.gslValue === null ? (
                        <span class="text missing">Not recorded</span>
                      ) : row.gslUrl ? (
                        <a class="text" href={row.gslUrl} rel="noopener noreferrer" target="_blank" title={row.gslValue}>{row.gslValue}</a>
                      ) : (
                        <span class="text" title={row.gslValue}>{row.gslValue}</span>
                      )}
                    </div>
                  </div>
                  {[["Typhoon", row.typhoon], ["Orion", row.orion]].map(([name, installs]) => (
                    <div class="cell" role="cell">
                      <span class="label">{name}</span>
                      {installs.length === 0 ? (
                        <div class="line"><span class="na">N/A</span></div>
                      ) : (
                        installs.map((install) => (
                          <div class="line" title={install.note ?? undefined}>
                            <svg class={`icon is-${install.comparison}`} viewBox="0 0 16 16" role="img" aria-label={COMPARISON_LABELS[install.comparison]}>
                              <title>{COMPARISON_LABELS[install.comparison]}</title>
                              {install.comparison === "current" ? <use href="#vm-current"/> : install.comparison === "behind" ? <use href="#vm-behind"/> : <use href="#vm-preview"/>}
                            </svg>
                            <span class:list={["text", { missing: install.version === null }]} title={install.version ?? undefined}>{install.version ?? "Not recorded"}</span>
                            {install.reference ? <span class="ref text">{install.reference}</span> : null}
                          </div>
                        ))
                      )}
                    </div>
                  ))}
                  <div class="cell links-cell" role="cell">
                    <div class="links">
                      {row.links.map((link) => (
                        link.meta.icon ? (
                          <a href={link.url} rel="noopener noreferrer" target="_blank" aria-label={link.meta.label} title={link.meta.label}>
                            <img class="platform-icon" src={link.meta.icon} alt={link.meta.label} loading="lazy" />
                          </a>
                        ) : null
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </>
      )}
    </div>
  </main>
</BaseLayout>
