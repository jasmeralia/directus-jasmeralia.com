---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import CsvHeader from "../../../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../../../components/GameThumbCard.astro";
import { directusFetchItems, getReviewedGameIds, getSTierGameIds, getTierChipsByGameId } from "../../../../lib/directus";
import { csvDataUri, gamesToCsv } from "../../../../lib/csv";
import { downloadLinks, getUrlPlatform, hasSteamDownloadLink } from "../../../../lib/download-link";
import { GAME_THUMB_FIELDS } from "../../../../lib/game-fields";
import { sortByTitle } from "../../../../lib/list-format";

const platformMeta = {
  steam: { label: "Steam" },
  "not-steam": { label: "Missing Link - Platform: Steam (No itch.io or GameStoryLog)" },
  itch: { label: "itch.io" },
  gog: { label: "GOG" },
  epic: { label: "Epic Games" },
  patreon: { label: "Patreon" },
  playstation: { label: "PlayStation" },
  xbox: { label: "Xbox" },
  unknown: { label: "Unknown" },
};

export async function getStaticPaths() {
  return ["steam", "not-steam", "itch", "gog", "epic", "patreon", "playstation", "xbox", "unknown"].map((platform) => ({ params: { platform } }));
}

const { platform } = Astro.params;
if (!platformMeta[platform]) {
  throw new Error(`Unsupported platform filter: ${platform}`);
}

const games = sortByTitle(await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  limit: -1,
}));
const filteredGames = games.filter((game) => {
  const links = downloadLinks(game?.links);
  if (platform === "unknown") {
    return links.length > 0 && links.some((link) => getUrlPlatform(link.url) === null);
  }
  if (platform === "not-steam") {
    const hasItchDownload = links.some((link) => getUrlPlatform(link.url) === "itch");
    const hasGameStoryLogLink = (game?.links ?? []).some((link) => link.kind === "gamestorylog");
    return !hasSteamDownloadLink(links) && !hasItchDownload && !hasGameStoryLogLink;
  }
  return links.some((link) => getUrlPlatform(link.url) === platform);
});

const gameIds = filteredGames
  .map((game) => game.id)
  .filter((id) => typeof id === "number");
const [reviewedGameIds, sTierGameIds, tierChipsByGame] = await Promise.all([
  getReviewedGameIds(gameIds),
  getSTierGameIds(gameIds),
  getTierChipsByGameId(gameIds),
]);

const platformLabel = platformMeta[platform].label;
const pageTitle = platform === "not-steam" ? platformLabel : `Download Platform + ${platformLabel}`;
const csvName = `download-platform-${platform}.csv`;
const csvHref = csvDataUri(gamesToCsv(filteredGames));
---

<BaseLayout title={`Filters | ${pageTitle}`}>
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;margin-bottom:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
    </style>
  </div>
  <main>
    <div class="panel">
      <CsvHeader title={pageTitle} count={filteredGames.length} csvHref={csvHref} csvName={csvName} />
      <p>{platform === "unknown"
        ? "Games with at least one download link whose platform could not be detected. Games with no download link at all belong on the Missing Link - Download filter instead."
        : platform === "not-steam"
          ? "Games with no Steam download link, no itch.io download link, and no GameStoryLog link. Includes games with no links at all."
        : `Games with download links detected as ${platformLabel}.`}</p>
    </div>
    <ThumbnailBorderLegend />
    {filteredGames.length === 0 ? (
      <p>{platform === "not-steam" ? "No games match this filter." : "No games found for this download platform."}</p>
    ) : (
      <div class="grid">
        {filteredGames.map((game) => {
          const reviewed = reviewedGameIds.has(game.id);
          const sTier = sTierGameIds.has(game.id);
          return <GameThumbCard game={game} reviewed={reviewed} sTier={sTier} tierChips={tierChipsByGame.get(game.id) ?? []} />;
        })}
      </div>
    )}
  </main>
</BaseLayout>
