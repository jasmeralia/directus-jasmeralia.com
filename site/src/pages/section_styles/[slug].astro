---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CsvHeader from "../../components/CsvHeader.astro";
import ThumbnailBorderLegend from "../../components/ThumbnailBorderLegend.astro";
import GameThumbCard from "../../components/GameThumbCard.astro";
import { directusFetchItems, getReviewedGameIds, getSTierGameIds } from "../../lib/directus";
import { csvDataUri, gamesToCsv } from "../../lib/csv";
import { GAME_THUMB_FIELDS } from "../../lib/game-fields";
import { sortByTitle } from "../../lib/list-format";

const STYLE_OPTIONS = [
  { slug: "linear", label: "Linear" },
  { slug: "nonlinear", label: "Nonlinear" },
];

export async function getStaticPaths() {
  return [
    { params: { slug: "linear" } },
    { params: { slug: "nonlinear" } },
  ];
}

const { slug } = Astro.params;
const label = STYLE_OPTIONS.find((style) => style.slug === slug)?.label;
if (!label) {
  throw new Error(`Unknown section style: ${slug}`);
}

const games = sortByTitle(await directusFetchItems("games", {
  fields: GAME_THUMB_FIELDS,
  filter: { section_style: { _eq: slug } },
  limit: -1,
}));

const gameIds = games.map((game) => game.id).filter((id) => typeof id === "number");
const [reviewedGameIds, sTierGameIds] = await Promise.all([
  getReviewedGameIds(gameIds),
  getSTierGameIds(gameIds),
]);

const csvName = `section-style-${slug}.csv`;
const csvHref = csvDataUri(gamesToCsv(games));

const description = `Games with section style ${label} - ${games.length} tracked by Jasmeralia.`;
---

<BaseLayout title={`Section Styles | ${label}`} description={description}>
  <div slot="head">
    <style>
      main{padding:2rem;}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}
    </style>
  </div>
  <main>
      <CsvHeader title={label} count={games.length} csvHref={csvHref} csvName={csvName} />
      <ThumbnailBorderLegend />
    {games.length === 0 ? (
        <p>No games found for this section style.</p>
      ) : (
        <div class="grid">
          {games.map((g) => {
            const reviewed = reviewedGameIds.has(g.id);
            const sTier = sTierGameIds.has(g.id);
            return (
              <GameThumbCard game={g} reviewed={reviewed} sTier={sTier} />
            );
          })}
        </div>
      )}
  </main>
</BaseLayout>
