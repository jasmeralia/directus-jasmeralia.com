---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { directusFetchItems, fileUrl, isFamilySharingDisabled } from '../../lib/directus';
import { formatDate } from "../../lib/date";
import { downloadLinks, walkthroughLinks, walkthroughTextNotes, getLinkMeta } from "../../lib/download-link";
import { buildGameHistory } from "../../lib/game-history";
import { effectiveSectionStyle, orderedBundleMembers } from "../../lib/game-bundles";
import { directGameSections, directGameSectionsByPosition, groupSectionsByCategory, orderedSections, pluralizeNoun, sectionNoun } from "../../lib/game-sections";
import { fetchActivity, fetchAllGameGenres, fetchRevisions } from "../../lib/changelog";
import { compareLabels } from "../../lib/list-format";
import { isGameNsfw } from "../../lib/nsfw";

export async function getStaticPaths() {
  // Every game page used to independently re-fetch its own game record,
  // reviews, franchises, tier entries, and (inside buildGameHistory)
  // revisions/activity/genres -- ~1,986 games x ~7 Directus round trips each.
  // Batch every collection once here and hand each page its own pre-sliced
  // props instead.
  //
  // GAME_FIELDS and groupBy must live inside this function, not alongside it
  // in the frontmatter: Astro's compiler hoists getStaticPaths out of the
  // enclosing module scope, so top-level consts/functions defined next to it
  // are undefined at runtime even though imports resolve fine.
  // https://github.com/withastro/roadmap/discussions/592
  const GAME_FIELDS = [
    'id',
    'title',
    'slug',
    'release_year',
    'family_sharing',
    'nsfw',
    'player_status',
    'game_status',
    'cover_image.id',
    'cover_image.filename_disk',
    'genres.id',
    'genres.genres_id.id',
    'genres.genres_id.name',
    'genres.genres_id.slug',
    'genres.genres_id.nsfw',
    'engines.id',
    'engines.engines_id.id',
    'engines.engines_id.title',
    'engines.engines_id.slug',
    'developers.id',
    'developers.developers_id.id',
    'developers.developers_id.name',
    'developers.developers_id.slug',
    'links.id',
    'links.url',
    'links.label',
    'links.kind',
    'links.sort',
    'section_style',
    'section_noun',
    'current_section',
    'sections.id',
    'sections.number',
    'sections.sort',
    'sections.title',
    'sections.category',
    'sections.completed',
    'sections.is_ending',
    'sections.bundle_member_id',
    'bundle_members.id',
    'bundle_members.sort',
    'bundle_members.slug',
    'bundle_members.title',
    'bundle_members.release_year',
    'bundle_members.cover_image.id',
    'bundle_members.cover_image.filename_disk',
    'bundle_members.player_status',
    'bundle_members.section_data_status',
    'bundle_members.section_noun',
    'bundle_members.current_section',
    'bundle_members.sections.id',
    'bundle_members.sections.number',
    'bundle_members.sections.title',
    'bundle_members.source_game_id.id',
    'bundle_members.source_game_id.title',
    'bundle_members.source_game_id.slug',
    'bundle_members.source_game_id.release_year',
    'bundle_members.source_game_id.cover_image.id',
    'bundle_members.source_game_id.cover_image.filename_disk',
    'included_in_bundles.id',
    'included_in_bundles.games_id.id',
    'included_in_bundles.games_id.title',
    'included_in_bundles.games_id.slug',
  ];

  // Group an array of rows by a key, dropping rows with a null/undefined key.
  function groupBy(rows, keyFn) {
    const map = new Map();
    for (const row of rows) {
      const key = keyFn(row);
      if (key === null || key === undefined) continue;
      const list = map.get(key) ?? [];
      list.push(row);
      map.set(key, list);
    }
    return map;
  }

  const [
    games,
    allReviews,
    allFranchiseEntries,
    allTierEntries,
    allGameRevisions,
    allReviewRevisions,
    allTierRevisions,
    allBundleMemberRevisions,
    allTierCreateActivities,
    allLinkActivities,
    genresByGame,
  ] = await Promise.all([
    directusFetchItems('games', {
      fields: GAME_FIELDS,
      limit: -1,
      sort: ['sort', 'title'],
    }),
    directusFetchItems('reviews', {
      fields: ['id', 'title', 'slug', 'status', 'rating', 'published_at', 'game'],
      limit: -1,
    }),
    directusFetchItems('franchise_games', {
      fields: ['game_id', 'franchise_id.id', 'franchise_id.title', 'franchise_id.slug'],
      filter: { franchise_id: { status: { _eq: "published" } } },
      limit: -1,
    }),
    directusFetchItems('tier_list_games', {
      fields: ['game_id', 'id', 'rating', 'tier_list_id.id', 'tier_list_id.title', 'tier_list_id.slug'],
      filter: { tier_list_id: { status: { _eq: "published" } } },
      limit: -1,
    }),
    fetchRevisions('games', -1),
    fetchRevisions('reviews', -1),
    fetchRevisions('tier_list_games', -1),
    fetchRevisions('game_bundle_members', -1),
    fetchActivity('tier_list_games', 'create', -1),
    fetchActivity('games_links', ['create', 'update'], -1),
    fetchAllGameGenres(),
  ]);

  const reviewsByGame = groupBy(allReviews, (r) => r.game);
  const franchisesByGame = groupBy(allFranchiseEntries, (f) => f.game_id);
  const tierEntriesByGame = groupBy(allTierEntries, (t) => t.game_id);

  return games
    .filter((g) => !!g.slug)
    .map((game) => {
      const reviewsForGame = reviewsByGame.get(game.id) ?? [];
      const publishedReviews = reviewsForGame
        .filter((r) => r.status === "published")
        .sort((a, b) => (b.published_at ?? "").localeCompare(a.published_at ?? ""))
        .slice(0, 100)
        .map((r) => ({ id: r.id, title: r.title, slug: r.slug, published_at: r.published_at }));
      const historyReviews = reviewsForGame.map((r) => ({
        id: r.id, title: r.title, status: r.status, rating: r.rating, published_at: r.published_at,
      }));
      const franchiseEntries = (franchisesByGame.get(game.id) ?? []).slice(0, 50);
      const tierEntries = (tierEntriesByGame.get(game.id) ?? [])
        .slice(0, 200)
        .sort((a, b) => compareLabels(a.tier_list_id?.title ?? "", b.tier_list_id?.title ?? ""));
      const bundleMembers = orderedBundleMembers(game.bundle_members);
      const sections = directGameSections(game.sections);
      const genres = genresByGame[game.id] ?? [];

      const history = buildGameHistory({
        gameId: game.id,
        reviews: historyReviews,
        tierEntries,
        links: game.links ?? [],
        bundleMembers,
        sections,
        genres,
        allGameRevisions,
        allReviewRevisions,
        allTierCreateActivities,
        allTierRevisions,
        allLinkActivities,
        allBundleMemberRevisions,
      });

      return {
        params: { slug: game.slug },
        props: { game, reviews: publishedReviews, franchiseEntries, tierEntries, bundleMembers, sections, history },
      };
    });
}

const { game, reviews, franchiseEntries, tierEntries, bundleMembers, sections, history } = Astro.props;

const PLAYER_STATUS_PHRASE: Record<string, string> = {
  not_started: "Jasmeralia hasn't started it yet.",
  in_progress: "Jasmeralia is currently playing it.",
  completed: "Jasmeralia has completed it.",
  did_not_finish: "Jasmeralia did not finish it.",
  waiting_for_update: "Jasmeralia is waiting for the next update.",
};

function gameSynopsis(title: string, gameStatus: string | null | undefined, playerStatus: string | null | undefined): string {
  if (gameStatus === "unreleased" || gameStatus === "in_development") {
    return `${title} - Jasmeralia is waiting for the release.`;
  }
  if (gameStatus === "abandoned") {
    return `${title} - Development abandoned.`;
  }
  const playerPhrase = playerStatus ? PLAYER_STATUS_PHRASE[playerStatus] : null;
  if (gameStatus === "released") {
    return playerPhrase ? `${title} - Released. ${playerPhrase}` : `${title} - Released.`;
  }
  return playerPhrase ? `${title} - ${playerPhrase}` : `${title} - Tracked by Jasmeralia.`;
}

const synopsis = gameSynopsis(game.title, game.game_status, game.player_status);

const noun = sectionNoun(game.section_noun);
const current = game.current_section ?? null;
const sectionStyle = effectiveSectionStyle(game);
const isNonlinear = game.section_style === "nonlinear";
const displaySections = isNonlinear ? directGameSectionsByPosition(game.sections) : sections;
const sectionGroups = isNonlinear ? groupSectionsByCategory(displaySections) : [];
const completedQuestCount = isNonlinear
  ? displaySections.filter((section) => section.completed).length
  : 0;
const includedIn = (game.included_in_bundles ?? [])
  .map((membership) => membership?.games_id)
  .filter((parent) => parent?.slug && parent?.title)
  .sort((a, b) => a.title.localeCompare(b.title, undefined, { sensitivity: "base" }));
const cover = fileUrl(game.cover_image);
const gameNsfw = isGameNsfw(game);
const labelize = (value) => value ? value.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()) : "";
const tierLabel = (value) => value === "U" ? "Too Early" : (value ?? "");
const genres = (game.genres ?? [])
  .map((genre) => genre?.genres_id)
  .filter((value) => value && value.name && value.slug);
const engines = (game.engines ?? [])
  .map((engine) => engine?.engines_id)
  .filter((value) => value && value.title && value.slug);
const developers = (game.developers ?? [])
  .map((developer) => developer?.developers_id)
  .filter((value) => value && (value.name || value.title) && value.slug)
  .sort((a, b) => (a.name ?? a.title ?? "").localeCompare(b.name ?? b.title ?? "", undefined, { sensitivity: "base" }));
const franchises = (franchiseEntries ?? [])
  .map((e) => e?.franchise_id)
  .filter((f) => f?.slug && f?.title)
  .sort((a, b) => a.title.localeCompare(b.title, undefined, { sensitivity: "base" }));
const tierListsMap = new Map();
for (const entry of (tierEntries ?? [])) {
  const list = entry?.tier_list_id;
  if (!list?.slug || !list?.title) continue;
  if (!tierListsMap.has(list.slug)) {
    tierListsMap.set(list.slug, { slug: list.slug, title: list.title, label: entry?.rating ?? "" });
  }
}
const tierLists = Array.from(tierListsMap.values())
  .sort((a, b) => a.title.localeCompare(b.title, undefined, { sensitivity: "base" }));
const gslLink = (game.links ?? []).find((l) => l.kind === "gamestorylog") ?? null;
const downloadEntries = downloadLinks(game.links).map((link) => {
  const linkMeta = getLinkMeta(link);
  return {
    url: link.url,
    linkMeta,
    linkText: linkMeta.label === "Download"
      ? linkMeta.host ? `Download (${linkMeta.host})` : "Download"
      : `Download from ${linkMeta.label}`,
  };
});
const walkthroughEntries = walkthroughLinks(game.links).map((link) => {
  const linkMeta = getLinkMeta(link);
  return {
    isTextNote: false as const,
    url: link.url,
    linkMeta,
    linkText:
      linkMeta.label === "Download"
        ? linkMeta.host
          ? `Walkthrough (${linkMeta.host})`
          : "Walkthrough"
        : `Walkthrough on ${linkMeta.label}`,
  };
});
const textNoteEntries = walkthroughTextNotes(game.links).map((link) => ({
  isTextNote: true as const,
  text: link.label ?? link.url,
}));
const reviewed = reviews.length > 0;
const sTier = tierLists.some((tier) => tier.label === "S");
const completed = game?.player_status === "completed";
const didNotFinish = game?.player_status === "did_not_finish";
const inProgress = game?.player_status === "in_progress";
const waitingForUpdate = game?.player_status === "waiting_for_update";
const hasWalkthrough = walkthroughEntries.length > 0 || textNoteEntries.length > 0;
const statusColor = completed
  ? "#c0c0c0"
  : didNotFinish
    ? "#d14b4b"
    : inProgress
      ? "#70b7ff"
      : waitingForUpdate
        ? "#1f6b2b"
        : null;
const innerBorderColor = hasWalkthrough
  ? "#8c58ff"
  : statusColor ?? (!reviewed && !sTier ? "#2b2b2b" : "transparent");
const statusRingColor = hasWalkthrough ? statusColor : null;
const coverStackStyle = [
  `--ring-rainbow-pad:${sTier ? 2 : 0}px`,
  `--ring-gold-pad:${reviewed ? 2 : 0}px`,
  `--ring-status-pad:${statusRingColor ? 2 : 0}px`,
  `--ring-status-color:${statusRingColor ?? "transparent"}`,
  `--gap-rainbow-pad:${sTier && (reviewed || hasWalkthrough || statusColor) ? 1 : 0}px`,
  `--gap-gold-pad:${reviewed && (hasWalkthrough || statusColor) ? 1 : 0}px`,
  `--gap-status-pad:${statusRingColor ? 1 : 0}px`,
  `--inner-border:${innerBorderColor}`,
].join(";");
---

<BaseLayout title={`Games | ${game.title}`} description={synopsis} image={gameNsfw ? null : cover}>
  <div slot="head">
    <style>
      .container { max-width: 1100px; margin: 0 auto; padding: 1.25rem; }
      .header { display: flex; gap: 1rem; align-items: center; }
      .cover-stack,.cover-ring-rainbow,.cover-gap-rainbow,.cover-ring-gold,.cover-gap-gold,.cover-ring-status,.cover-gap-status,.cover-card{border-radius:10px;}
      .cover-ring-rainbow,.cover-gap-rainbow,.cover-ring-gold,.cover-gap-gold,.cover-ring-status,.cover-gap-status{padding:0;background:transparent;}
      .cover-ring-rainbow{
        padding:var(--ring-rainbow-pad,0);
        background:linear-gradient(135deg,#ff5f6d,#ffc371,#fff45f,#6dff9a,#5fe2ff,#8c7bff,#ff6ddf);
        box-shadow:0 0 0 1px rgba(255,255,255,.06), 0 0 14px rgba(255,180,80,.22);
      }
      .cover-gap-rainbow{padding:var(--gap-rainbow-pad,0);background:#000;}
      .cover-ring-gold{padding:var(--ring-gold-pad,0);background:#d3a43b;}
      .cover-gap-gold{padding:var(--gap-gold-pad,0);background:#000;}
      .cover-ring-status{padding:var(--ring-status-pad,0);background:var(--ring-status-color,transparent);}
      .cover-gap-status{padding:var(--gap-status-pad,0);background:#000;}
      .cover-card{width:320px;background:#000;border:2px solid var(--inner-border,#2b2b2b);padding:10px;}
      .cover-card img { width: 100%; height: auto; object-fit: contain; display: block; }
      .meta { opacity: 0.9; }
      .section{margin-top:1.5rem;}
      .label{opacity:.7;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;}
      .panel{background:#111;border:1px solid #222;border-radius:12px;padding:16px;}
      .panel a{color:#9aa6ff;}
      .panel a:visited{color:#9aa6ff;}
      .meta a{color:#9aa6ff;}
      .meta a:visited{color:#9aa6ff;}
      .download-link{display:inline-flex;align-items:center;gap:.45rem;}
      .download-link img{width:1rem;height:1rem;display:block;}
      .download-link .platform-icon{filter:brightness(0) saturate(100%) invert(67%) sepia(11%) saturate(1832%) hue-rotate(194deg) brightness(97%) contrast(96%);}
      .download-link .gsl-icon{filter:none;}
      .sections-summary{margin:.5rem 0;}
      .sections-list{margin-bottom:0;}
      .sections-list li{padding:.2rem .5rem;border-left:2px solid transparent;}
      .sections-list .current-section{color:#8c58ff;border-left-color:#8c58ff;font-weight:700;}
      .sections-list .section-completed{opacity:.6;text-decoration:line-through;}
      .quest-category{margin-top:1rem;}
      .quest-category:first-child{margin-top:.5rem;}
      .quest-category-title{margin:0 0 .3rem;font-size:.85rem;opacity:.8;text-transform:uppercase;letter-spacing:.06em;}
      .quest-list li{list-style:disc;margin-left:1.1rem;padding:.15rem .5rem;}
      .quest-list .quest-completed{opacity:.6;text-decoration:line-through;}
      .quest-list .is-ending{color:#8c58ff;font-weight:700;text-decoration:none;}
      .quest-ending-badge{margin-left:.4rem;font-size:.75rem;opacity:.85;text-decoration:none;}
      .bundle-list{display:flex;flex-direction:column;gap:.75rem;margin-top:.75rem;}
      .bundle-member{background:#0b0b0b;border:1px solid #222;border-radius:10px;padding:.75rem;}
      .bundle-member-header{display:flex;gap:.75rem;align-items:center;}
      .bundle-member-cover{width:54px;height:81px;object-fit:contain;background:#000;border-radius:5px;flex-shrink:0;}
      .bundle-member-cover-wrap{display:block;width:54px;height:81px;border-radius:5px;flex-shrink:0;}
      .bundle-member-cover-wrap .bundle-member-cover{display:block;}
      .bundle-member-cover-wrap.nsfw-cover::after{font-size:.55rem;padding:.2rem;}
      .nsfw-banner{border-color:#7a3030;color:#ffaaaa;margin-bottom:1rem;}
      .bundle-member-info{display:flex;flex-direction:column;gap:.15rem;}
      .bundle-member-title{font-weight:700;}
      .bundle-member-meta{font-size:.85rem;opacity:.72;}
      .bundle-member details{margin-top:.65rem;}
      .bundle-member summary{cursor:pointer;color:#9aa6ff;}
      .tabs{display:flex;gap:.5rem;margin-top:1.5rem;border-bottom:1px solid #222;}
      .tab-btn{background:none;border:none;color:#9aa6ff;padding:.6rem 1rem;font-size:1rem;cursor:pointer;border-bottom:2px solid transparent;}
      .tab-btn.active{color:#fff;border-bottom-color:#8c58ff;}
      .history-list{list-style:none;margin:0;padding:0;}
      .history-list li{padding:.75rem 0;border-bottom:1px solid #222;}
      .history-list li:last-child{border-bottom:none;}
      .history-date{opacity:.6;font-size:.8rem;}
      .history-title{font-weight:600;margin:.15rem 0;}
      :global(.history-changes){margin:.25rem 0 0;padding-left:1.25rem;opacity:.9;font-size:.9rem;}
    </style>
  </div>
  <main class="container" data-pagefind-body data-pagefind-filter="type:game">
      <span data-pagefind-meta="nsfw" style="display:none;">{String(gameNsfw)}</span>
      {gameNsfw ? <div class="panel nsfw-banner">This game is marked NSFW.</div> : null}
      <section class="header">
        <div class="cover-stack" style={coverStackStyle}>
          <div class="cover-ring-rainbow">
            <div class="cover-gap-rainbow">
              <div class="cover-ring-gold">
                <div class="cover-gap-gold">
                  <div class="cover-ring-status">
                    <div class="cover-gap-status">
                      <div class={`cover-card${gameNsfw ? " nsfw-cover" : ""}`}>
                        {cover ? <img src={cover} alt={game.title} loading="lazy" data-pagefind-meta="image[src]" /> : null}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div>
          <h1 data-pagefind-meta="title">{game.title}</h1>
                    {downloadEntries.length > 0 || gslLink ? (
            <div class="meta">
              {downloadEntries.map((entry) => (
                <div>
                  <a class="download-link" href={entry.url} rel="noopener noreferrer" target="_blank">
                    {entry.linkMeta.icon ? (
                      <img class="platform-icon" src={entry.linkMeta.icon} alt="" aria-hidden="true" loading="lazy" />
                    ) : null}
                    <span>{entry.linkText}</span>
                  </a>
                </div>
              ))}
              {gslLink ? (
                <div>
                  <a class="download-link" href={gslLink.url} rel="noopener noreferrer" target="_blank">
                    <img class="gsl-icon" src="/icons/gamestorylog.png" alt="" aria-hidden="true" loading="lazy" />
                    <span>View on GameStoryLog</span>
                  </a>
                </div>
              ) : null}
            </div>
          ) : null}
        </div>
      </section>

      <div class="tabs" role="tablist">
        <button type="button" class="tab-btn active" role="tab" aria-selected="true" aria-controls="tab-details" id="tab-details-btn">Details</button>
        <button type="button" class="tab-btn" role="tab" aria-selected="false" aria-controls="tab-history" id="tab-history-btn">History</button>
      </div>
      <div id="tab-details" role="tabpanel" aria-labelledby="tab-details-btn">
      <div class="section panel">
        <div class="label">Details</div>
        <ul>
          {developers.length ? (
            <li>
              <strong>Developers:</strong> {developers.map((developer, index) => (
                <span>
                  <a href={`/developers/${developer.slug}/index.html`}>{developer.name ?? developer.title}</a>
                  {index < developers.length - 1 ? ", " : ""}
                </span>
              ))}
            </li>
          ) : null}
          {engines.length ? (
            <li>
              <strong>Engines:</strong> {engines.map((engine, index) => (
                <span>
                  <a href={`/engines/${engine.slug}/index.html`}>{engine.title}</a>
                  {index < engines.length - 1 ? ", " : ""}
                </span>
              ))}
            </li>
          ) : null}
          <li>
            <strong>Content rating:</strong>{" "}
            <a href={`/filters/content-rating/${gameNsfw ? "nsfw" : "sfw"}/index.html`}>{gameNsfw ? "NSFW" : "SFW"}</a>
          </li>
          {game.game_status ? (
            <li>
              <strong>Game status:</strong> <a href={`/game_statuses/${game.game_status}/index.html`}>{labelize(game.game_status)}</a>
            </li>
          ) : null}
          {genres.length ? (
            <li>
              <strong>Genres:</strong> {genres.map((genre, index) => (
                <span>
                  <a href={`/genres/${genre.slug}/index.html`}>{genre.name}</a>
                  {index < genres.length - 1 ? ", " : ""}
                </span>
              ))}
            </li>
          ) : null}
          {game.player_status ? (
            <li>
              <strong>Player status:</strong> <a href={`/played_statuses/${game.player_status}/index.html`}>{labelize(game.player_status)}</a>
            </li>
          ) : null}
          {sectionStyle ? (
            <li>
              <strong>Section style:</strong> <a href={`/filters/section-style/${sectionStyle}/index.html`}>{labelize(sectionStyle)}</a>
            </li>
          ) : null}
          {game.release_year ? (
            <li>
              <strong>Release year:</strong>{" "}
              <a href={`/releases/${game.release_year}/index.html`}>{game.release_year}</a>
            </li>
          ) : null}
          {isFamilySharingDisabled(game) ? (
            <li><strong>Steam Family Sharing is NOT supported for this title.</strong></li>
          ) : null}
          {franchises.length ? (
            <li>
              <strong>Franchises:</strong> {franchises.map((f, index) => (
                <span>
                  <a href={`/franchises/${f.slug}/index.html`}>{f.title}</a>
                  {index < franchises.length - 1 ? ", " : ""}
                </span>
              ))}
            </li>
          ) : null}
          {includedIn.length ? (
            <li>
              <strong>Included in:</strong> {includedIn.map((parent, index) => (
                <span>
                  <a href={`/games/${parent.slug}/index.html`}>{parent.title}</a>
                  {index < includedIn.length - 1 ? ", " : ""}
                </span>
              ))}
            </li>
          ) : null}
          {tierLists.length ? (
            <li>
              <strong>Tier lists:</strong> {tierLists.map((tier, index) => (
                <span>
                  <a href={`/tiers/${tier.slug}/index.html`}>{tier.title}</a>
                  {tier.label ? ` (${tierLabel(tier.label)})` : ""}
                  {index < tierLists.length - 1 ? ", " : ""}
                </span>
              ))}
            </li>
          ) : null}
          {(walkthroughEntries.length > 0 || textNoteEntries.length > 0) ? (
            <li>
              <strong>Walkthrough:</strong>{" "}
              {walkthroughEntries.map((entry, index) => (
                <>
                  {index > 0 ? <span> | </span> : null}
                  <a class="download-link" href={entry.url} rel="noopener noreferrer" target="_blank">
                    {entry.linkMeta.icon ? (
                      <img class="platform-icon" src={entry.linkMeta.icon} alt="" aria-hidden="true" loading="lazy" />
                    ) : null}
                    <span>{entry.linkText}</span>
                  </a>
                </>
              ))}
              {textNoteEntries.map((note, index) => (
                <>
                  {(walkthroughEntries.length > 0 || index > 0) ? <span> | </span> : null}
                  <span>{note.text}</span>
                </>
              ))}
            </li>
          ) : null}
        </ul>
      </div>

      {bundleMembers.length > 0 ? (
        <div class="section panel">
          <div class="label">Included Games</div>
          <div class="bundle-list">
            {bundleMembers.map((member) => {
              const source = typeof member.source_game_id === "object"
                ? member.source_game_id
                : null;
              const memberCover = fileUrl(member.cover_image ?? source?.cover_image);
              const memberReleaseYear = member.release_year ?? source?.release_year ?? null;
              const memberSections = orderedSections(member.sections);
              const memberNoun = sectionNoun(member.section_noun);
              const memberCurrent = member.current_section ?? null;
              const sectionStatus = member.section_data_status ?? "unknown";
              return (
                <article class="bundle-member">
                  <div class="bundle-member-header">
                    {memberCover ? (
                      <span class={gameNsfw ? "nsfw-cover bundle-member-cover-wrap" : "bundle-member-cover-wrap"}>
                        <img
                          class="bundle-member-cover"
                          src={memberCover}
                          alt={member.title}
                          loading="lazy"
                        />
                      </span>
                    ) : null}
                    <div class="bundle-member-info">
                      <div class="bundle-member-title">
                        {source?.slug
                          ? <a href={`/games/${source.slug}/index.html`}>{member.title}</a>
                          : member.title}
                      </div>
                      {memberReleaseYear ? (
                        <div class="bundle-member-meta">Released {memberReleaseYear}</div>
                      ) : null}
                      <div class="bundle-member-meta">
                        Player status: {labelize(member.player_status)}
                      </div>
                      {sectionStatus === "tracked" ? (
                        <div class="bundle-member-meta">
                          {member.player_status === "in_progress" && memberCurrent === null
                            ? `In Progress - Current ${memberNoun.toLowerCase()} unknown`
                            : memberCurrent !== null
                            ? `Currently on ${memberNoun} ${memberCurrent} of ${memberSections.length}`
                            : `${memberSections.length} ${pluralizeNoun(memberNoun)}`}
                        </div>
                      ) : sectionStatus === "not_applicable" ? (
                        <div class="bundle-member-meta">No chapter or mission tracking</div>
                      ) : (
                        <div class="bundle-member-meta">Section data not researched</div>
                      )}
                    </div>
                  </div>
                  {sectionStatus === "tracked" && memberSections.length > 0 ? (
                    <details>
                      <summary>Show {memberSections.length} {pluralizeNoun(memberNoun)}</summary>
                      <ol class="sections-list">
                        {memberSections.map((section) => (
                          <li
                            class:list={{
                              "current-section": section.number === memberCurrent,
                              "section-completed": member.player_status === "completed"
                                || (memberCurrent !== null && section.number < memberCurrent),
                            }}
                            aria-current={section.number === memberCurrent ? "step" : undefined}
                          >
                            {section.title}
                          </li>
                        ))}
                      </ol>
                    </details>
                  ) : null}
                </article>
              );
            })}
          </div>
        </div>
      ) : null}

      {isNonlinear ? (
        displaySections.length > 0 ? (
          <div class="section panel">
            <div class="label">{pluralizeNoun(noun)}</div>
            <p class="sections-summary">
              {`${completedQuestCount} of ${displaySections.length} ${pluralizeNoun(noun)} completed`}
            </p>
            {sectionGroups.map((group) => (
              <div class="quest-category">
                {group.category ? <h4 class="quest-category-title">{group.category}</h4> : null}
                <ul class="sections-list quest-list">
                  {group.sections.map((section) => (
                    <li class:list={{ "quest-completed": section.completed, "is-ending": section.is_ending }}>
                      {section.title}
                      {section.is_ending ? <span class="quest-ending-badge">(Ending)</span> : null}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : null
      ) : sections.length > 0 ? (
        <div class="section panel">
          <div class="label">{pluralizeNoun(noun)}</div>
          <p class="sections-summary">
            {current !== null
              ? `Currently on ${noun} ${current} of ${sections.length}`
              : `${sections.length} ${pluralizeNoun(noun)}`}
          </p>
          <ol class="sections-list">
            {sections.map((section) => (
              <li
                class:list={{
                  "current-section": section.number === current,
                  "section-completed": completed || (current !== null && section.number < current),
                }}
                aria-current={section.number === current ? "step" : undefined}
              >
                {section.title}
              </li>
            ))}
          </ol>
        </div>
      ) : null}

      {reviews.length ? (
        <div class="section panel">
          <div class="label">Reviews</div>
          <ul>
            {reviews.map((review) => (
              <li>
                <a href={`/reviews/${review.slug}/index.html`}>{review.title}</a>
                {review.published_at ? (
                  <span style="opacity:.7;margin-left:.5rem;">({formatDate(review.published_at)})</span>
                ) : null}
              </li>
            ))}
          </ul>
        </div>
      ) : null}
      </div>
      <div id="tab-history" role="tabpanel" aria-labelledby="tab-history-btn" hidden>
        <div class="section panel">
          <div class="label">History</div>
          {history.length ? (
            <ul class="history-list">
              {history.map((entry) => (
                <li>
                  <div class="history-date">{formatDate(entry.date.toISOString())}</div>
                  <div class="history-title">{entry.title}</div>
                  <Fragment set:html={entry.bodyHtml} />
                </li>
              ))}
            </ul>
          ) : (
            <p>No recorded history yet.</p>
          )}
        </div>
      </div>
  </main>
</BaseLayout>

<script>
  (() => {
    const btns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    for (const btn of btns) {
      btn.addEventListener("click", () => {
        for (const b of btns) {
          b.classList.toggle("active", b === btn);
          b.setAttribute("aria-selected", String(b === btn));
        }
        const panelId = btn.getAttribute("aria-controls");
        for (const panel of document.querySelectorAll<HTMLElement>('[role="tabpanel"]')) {
          panel.hidden = panel.id !== panelId;
        }
      });
    }
  })();
</script>
