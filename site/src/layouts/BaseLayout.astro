---
import Nav from "../components/Nav.astro";
import { fileUrl, siteBaseUrl } from "../lib/directus";

const DEFAULT_DESCRIPTION = "Jasmeralia's game backlog, reviews, and tier lists.";
const DEFAULT_IMAGE = fileUrl({ id: "1ddf76e1-bbf2-42f4-9250-bd17bc3bb92c", filename_disk: "1ddf76e1-bbf2-42f4-9250-bd17bc3bb92c.png" });

const {
  title = "Jasmeralia",
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_IMAGE,
  type = "website",
} = Astro.props;
const year = new Date().getFullYear();
const canonicalUrl = `${siteBaseUrl()}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="Jasmeralia Feed" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="Jasmeralia Feed (SFW)" href="/feed-sfw.xml" />
    <link rel="alternate" type="application/rss+xml" title="Jasmeralia Feed (NSFW)" href="/feed-nsfw.xml" />
    <link rel="alternate" type="application/rss+xml" title="Jasmeralia Feed (Completed Games)" href="/feed-completed.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Jasmeralia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image ? <meta property="og:image" content={image} /> : null}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image ? <meta name="twitter:image" content={image} /> : null}
    <script is:inline>
      if(document.cookie.split('; ').some(function(cookie){return cookie === 'nsfw_mode=1';})){
        document.documentElement.classList.add('nsfw-on');
      }
    </script>
    <style>
      body{background:#000010;color:#eaeaea;font-family:system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;margin:0;}
      a{color:#9aa6ff;}
      footer{color:#c6c6c6;font-size:0.9rem;padding:28px 16px;text-align:center;}
      .footer-links{align-items:center;display:inline-flex;gap:14px;margin-left:10px;}
      .footer-link{align-items:center;display:inline-flex;gap:6px;text-decoration:none;}
      .footer-link svg{height:16px;width:16px;}
      .footer-rss-variants{margin-left:-8px;}
      .footer-meta{display:block;font-size:0.75rem;margin-top:8px;opacity:0.8;}
      .spoiler{background:#2a2a2a;color:transparent;border-radius:3px;padding:0 3px;cursor:pointer;user-select:none;transition:color .15s;}
      .spoiler.revealed{color:inherit;}
      :global(.nsfw-cover){position:relative;overflow:hidden;}
      :global(.nsfw-cover img){filter:blur(20px) brightness(.5);transition:filter .15s;}
      :global(html.nsfw-on .nsfw-cover img),:global(.nsfw-cover.revealed img){filter:none;}
      :global(.nsfw-cover::after){content:"NSFW - click to reveal";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:.75rem;padding:.5rem;box-sizing:border-box;background:rgba(0,0,0,.35);color:#eaeaea;cursor:pointer;}
      :global(html.nsfw-on .nsfw-cover::after),:global(.nsfw-cover.revealed::after){display:none;}
      :global(.nsfw-text){background:#2a2a2a;border-radius:3px;padding:0 3px;cursor:pointer;user-select:none;transition:color .15s;}
      :global(.nsfw-text),:global(.nsfw-text *){color:transparent!important;}
      :global(html.nsfw-on .nsfw-text),:global(html.nsfw-on .nsfw-text *),:global(.nsfw-text.revealed),:global(.nsfw-text.revealed *){color:inherit!important;}
    </style>
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <slot />
    <footer data-pagefind-ignore>
      © {year} by Morgan Blackthorne
      <span class="footer-links">
        <a class="footer-link" href="https://twitter.com/jasmeralia" aria-label="Twitter: jasmeralia">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M19.94 7.12c.01.17.01.34.01.51 0 5.25-4 11.29-11.29 11.29-2.25 0-4.34-.66-6.1-1.79h.92c1.86 0 3.58-.63 4.95-1.7a4 4 0 0 1-3.73-2.77c.25.04.49.06.75.06.35 0 .7-.05 1.02-.13a4 4 0 0 1-3.2-3.92v-.05c.54.3 1.16.49 1.82.51a4 4 0 0 1-1.24-5.34 11.34 11.34 0 0 0 8.23 4.17 4.01 4.01 0 0 1 6.82-3.65 8.1 8.1 0 0 0 2.54-.97 4 4 0 0 1-1.76 2.21 8.03 8.03 0 0 0 2.3-.62 8.6 8.6 0 0 1-2 2.07Z"/>
          </svg>
          @jasmeralia
        </a>
        <a class="footer-link" href="https://discord.gg/Seyngsh5MF" aria-label="Discord invite">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M20.32 4.37A19.3 19.3 0 0 0 15.67 3a13.6 13.6 0 0 0-.63 1.3 18.1 18.1 0 0 0-5.08 0A13.6 13.6 0 0 0 9.33 3a19.1 19.1 0 0 0-4.66 1.37C1.92 8.7 1.25 12.9 1.57 17.03a19.2 19.2 0 0 0 5.64 2.87c.46-.62.87-1.28 1.23-1.97a12.2 12.2 0 0 1-1.93-.93c.16-.12.32-.24.47-.36 3.72 1.73 7.76 1.73 11.43 0 .15.12.31.24.47.36-.61.35-1.26.67-1.93.93.36.69.77 1.35 1.23 1.97a19.1 19.1 0 0 0 5.64-2.87c.42-4.76-.7-8.92-3.33-12.66ZM8.58 14.55c-1.02 0-1.85-.94-1.85-2.1 0-1.16.82-2.1 1.85-2.1 1.03 0 1.86.95 1.85 2.1 0 1.16-.82 2.1-1.85 2.1Zm6.84 0c-1.02 0-1.85-.94-1.85-2.1 0-1.16.82-2.1 1.85-2.1 1.03 0 1.86.95 1.85 2.1 0 1.16-.82 2.1-1.85 2.1Z"/>
          </svg>
          Discord
        </a>
        <a class="footer-link" href="/feed.xml" aria-label="RSS feed">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>
        <span class="footer-rss-variants">(<a href="/feed-sfw.xml">SFW</a> / <a href="/feed-nsfw.xml">NSFW</a> / <a href="/feed-completed.xml">Completed</a>)</span>
      </span>
      <span class="footer-meta" id="footer-build"></span>
    </footer>
    <script is:inline>
      fetch('/build-info.json').then(function(r){return r.json();}).then(function(d){
        const el=document.getElementById('footer-build');
        if(el)el.textContent='Site last published on '+d.built;
      }).catch(function(){});
      document.addEventListener('click',function(e){
        const s=e.target.closest('.spoiler');
        if(s)s.classList.toggle('revealed');
        const n=e.target.closest('.nsfw-cover,.nsfw-text');
        if(n&&!document.documentElement.classList.contains('nsfw-on')&&!n.classList.contains('revealed')){
          e.preventDefault();
          n.classList.add('revealed');
        }
      });
    </script>
  </body>
</html>
